// The window — docs/GUI.md is the design this implements.
//
// **Three tabs, and the first one is the device.** Per the operator, 2026-08-21: the main view is
// the iPod at full size and *pressing it* is what starts it, so the chrome carries no Start button
// at all. Devices are composed out of Resources on their own tab; Resources is the files.
//
// **There is no sidebar.** The first cut had one, 280 px wide, holding a list that will realistically
// never exceed half a dozen entries — 25 % of the window for three words, which left the subject of
// the program on 13 % of the stage. Master–detail was solving a scaling problem this program does
// not have.

import { Ink, Metric } from "tokens.slint";
import { IPod } from "ipod.slint";

export struct DeviceRow {
    name: string,
    summary: string,
    state: string,
    write-target: string,
    write-target-is-warning: bool,
    chassis: color,
    dark-chassis: bool,
    parked: bool,
}

// A flat list with headings in it, rather than a list of groups each holding a list. Slint handles
// both; this one is easier to keep in step with the model, which is a `Vec` of the same shape.
export struct ResourceRow {
    heading: bool,
    text: string,
    detail: string,
}

// ─── The material (§7) ──────────────────────────────────────────────────────────────────────────
//
// Used for exactly two things: the primary action, and the selected tab. Everywhere else is flat. A
// window where everything is glossy is a pastiche; a window where the one thing you are about to
// press is glossy is a 2005 idea applied with judgement.

component Material inherits Rectangle {
    background: @linear-gradient(180deg, Ink.material-top 0%, Ink.material-bottom 100%);
    Rectangle {
        y: 0;
        height: 1px;
        background: Ink.material-rule;
    }
}

// ─── One button ─────────────────────────────────────────────────────────────────────────────────
//
// **One height, one radius, one weight, one type size.** The first cut had a 42 px primary, a 32 px
// secondary and a 28 px tab — three button systems in a window with four buttons in it. Only the
// fill changes between a primary and a plain one.

component Button inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 36px;
    width: text.preferred-width + 2 * Metric.s5;
    border-radius: 6px;
    background: primary ? transparent : Ink.bg-raised;
    border-width: primary ? 0 : 1px;
    border-color: Ink.line.with-alpha(0.4);
    opacity: enabled ? 1.0 : 0.5;

    Material {
        width: 100%;
        height: 100%;
        border-radius: 6px;
        visible: primary && enabled;
        opacity: touch.pressed ? 0.86 : 1.0;
        animate opacity { duration: Metric.quick; }
    }

    text := Text {
        width: 100%;
        height: 100%;
        text: label;
        font-size: Metric.body-size;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: !enabled ? Ink.fg-disabled : (primary ? #ffffff : Ink.fg);
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component Tab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    // The same 36 px as a button, so the chrome has one rhythm rather than three.
    height: 36px;
    width: text.preferred-width + 2 * Metric.s4;
    border-radius: 6px;

    Material {
        width: 100%;
        height: 100%;
        border-radius: 6px;
        visible: active;
    }

    text := Text {
        width: 100%;
        height: 100%;
        text: label;
        font-size: Metric.body-size;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: active ? #ffffff : (touch.has-hover ? Ink.fg : Ink.fg-dim);
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Caption inherits Text {
    font-size: Metric.body-size;
    color: Ink.fg-dim;
    horizontal-alignment: center;
}

// ─── The window ─────────────────────────────────────────────────────────────────────────────────

export component MainWindow inherits Window {
    title: "ipod-emulator";
    background: Ink.bg;
    // §6, revised: the minimum is not a taste either. A 1:1 320×240 framebuffer needs a 658 px
    // device (see `hero` below), and 56 chrome + 658 + a caption + padding is 852. Below that the
    // choice is a smaller window or a downscaled screen, and principle 8 settles which.
    min-width: 900px;
    min-height: 860px;
    preferred-width: 1100px;
    preferred-height: 880px;
    forward-focus: keys;

    in property <[DeviceRow]> devices;
    in property <[ResourceRow]> resources;
    in-out property <int> selected: 0;
    in-out property <int> tab: 0;
    in property <image> screen-source;
    in property <bool> running: false;

    callback start-device(int);
    callback new-device();

    property <bool> has-devices: devices.length > 0;
    property <DeviceRow> current: has-devices
        ? devices[selected]
        : { name: "", chassis: #e4e4e2, dark-chassis: false };


    public function move(delta: int) {
        if (devices.length == 0) { return; }
        selected = clamp(selected + delta, 0, devices.length - 1);
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.LeftArrow)  { root.move(-1); return accept; }
            if (event.text == Key.RightArrow) { root.move(1);  return accept; }
            if (event.text == Key.Return && root.has-devices) {
                root.start-device(root.selected);
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            // ── The only chrome (§4) ──
            Rectangle {
                height: 56px;
                background: @linear-gradient(180deg, Ink.bg-band-top 0%, Ink.bg-band-bottom 100%);
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Ink.line.with-alpha(0.5);
                }

                // No `alignment` here on purpose: setting one packs the children and makes
                // `horizontal-stretch` inert, which is why Help and About once sat next to
                // Resources instead of at the far edge.
                HorizontalLayout {
                    padding-left: Metric.s5;
                    padding-right: Metric.s5;
                    padding-top: Metric.s2;
                    padding-bottom: Metric.s2;
                    spacing: Metric.s1;

                    Tab { label: "iPod";      active: tab == 0; clicked => { tab = 0; } }
                    Tab { label: "Devices";   active: tab == 1; clicked => { tab = 1; } }
                    Tab { label: "Resources"; active: tab == 2; clicked => { tab = 2; } }

                    Rectangle { horizontal-stretch: 1; }

                    Tab { label: "Help";  active: false; }
                    Tab { label: "About"; active: false; }
                }
            }

            // ── Tab 1 — the device, and pressing it is what starts it ──
            if tab == 0: pane := Rectangle {
                background: Ink.bg;
                vertical-stretch: 1;
                // Pinned to zero so the pane reports no intrinsic height of its own and takes
                // whatever the window has left. Without it, `hero` below would be reading a height
                // that its own content decides — the loop again, one level up.
                min-height: 0px;
                preferred-height: 0px;

                // One number sets the size of everything on this tab — read from the stage, never
                // from the window.
                //
                // **Reading the window's height here is a binding loop**: the window's height comes
                // from its layout, the layout from the content, the content from `hero`. Slint says
                // so at build time and warns it may panic at run time. It is the same bug as the
                // device that resized itself (GUI.md §6) in a different hat — a size that can
                // influence its own container oscillates. `stage-area` declares no intrinsic height,
                // so the arrow points one way only.
                // **655.751 px, and every digit is doing work.**
                //
                // `320 / 0.48799 = 655.751` and `240 / 0.36599 = 655.756` — the same number to four
                // figures, because §6.6 made the well exactly 4:3. That is the body height at which
                // one framebuffer pixel is one device pixel.
                //
                // It was 658 px against a 0.4866 / 0.3672 pair, which drew the panel 320.18 × 241.62
                // for a 320 × 240 buffer: a stretch, not a scale, in the one rule this project will
                // not bend. Before that it was 560 px, which threw away a quarter of every frame.
                // Neither was visible on screen and neither failed a test.
                //
                // **Still logical pixels, and that is a known gap.** At a fractional display scale
                // this is a fractional number of device pixels; docs/GUI.md §6.6 makes `hero` a
                // physical `k × 655.751` pushed in from Rust, and §20 item 10 requires the test that
                // catches it to be proved red at `sf = 2.75, k = 7` first. At sf 1 and sf 2 — every
                // Mac and most Windows machines — this is already exact.
                //
                // It is a constant rather than a function of the window, which is what keeps it
                // loop-free: a size derived from a height it can itself influence oscillates.
                property <length> hero: 655.751px;
                property <length> hero-w: 0.5917 * hero;
                property <length> step: hero-w * 0.5 + hero-w * 0.55 * 0.5 + Metric.s7;

                VerticalLayout {
                    padding: Metric.s4;
                    spacing: Metric.s4;
                    alignment: center;

                    // The carousel. Absolute positions, animated, so the neighbours slide rather
                    // than reflow — a layout that re-flows on selection is one that jumps (§2.2).
                    //
                    stage-area := Rectangle {
                        height: pane.hero;
                        width: 100%;

                        for d[i] in devices: IPod {
                            body-height: i == root.selected ? pane.hero : pane.hero * 0.55;
                            chassis: d.chassis;
                            dark-chassis: d.dark-chassis;
                            screen-source: i == root.selected ? root.screen-source : @image-url("");
                            screen-lit: i == root.selected && root.running;
                            pressable: i == root.selected;
                            x: parent.width / 2 - self.width / 2 + (i - root.selected) * pane.step;
                            y: (parent.height - self.height) / 2;
                            opacity: i == root.selected ? 1.0 : 0.3;
                            clicked => { root.selected = i; }
                            pressed-device => { root.start-device(i); }

                            animate x, opacity, body-height {
                                duration: Metric.settle;
                                easing: ease-out-quart;
                            }
                        }

                        // Empty (§9): the hero iPod at rest, not a bare "nothing here".
                        IPod {
                            body-height: pane.hero;
                            chassis: #e4e4e2;
                            dark-chassis: false;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            visible: !root.has-devices;
                            opacity: 0.45;
                        }
                    }

                    // `alignment: start` and no stretch: without both, this column takes the
                    // slack and spreads four lines of caption over three hundred pixels.
                    VerticalLayout {
                        spacing: Metric.s2;
                        alignment: start;
                        vertical-stretch: 0;

                        Text {
                            text: root.has-devices ? root.current.name : "No devices yet";
                            font-size: Metric.display-size;
                            font-weight: 600;
                            color: Ink.fg;
                            horizontal-alignment: center;
                        }

                        Caption {
                            text: root.has-devices ? root.current.summary : "";
                            height: 20px;
                        }

                        // §10: whose file is about to be written to, before the machine starts.
                        Text {
                            text: root.current.write-target;
                            font-size: Metric.label-size;
                            color: root.current.write-target-is-warning ? Ink.warn : Ink.fg-dim;
                            horizontal-alignment: center;
                            height: 16px;
                        }

                        // The instruction, because an iPod that starts when you press its centre
                        // button is only obvious once you know. It goes once it is running.
                        Caption {
                            text: !root.has-devices
                                ? "Make one on the Devices tab — you need no iPod and no files."
                                : (root.running ? "" : "Press the centre button to start");
                            height: 20px;
                        }

                        // Where you are in the carousel. Only earns its place past one device.
                        HorizontalLayout {
                            padding-top: Metric.s3;
                            spacing: Metric.s2;
                            alignment: center;
                            height: 8px;
                            visible: devices.length > 1;

                            for d[i] in devices: Rectangle {
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                background: i == root.selected ? Ink.accent : Ink.line.with-alpha(0.4);
                                animate background { duration: Metric.settle; }
                            }
                        }
                    }
                }
            }

            // ── Tab 2 — devices, composed out of resources ──
            if tab == 1: Rectangle {
                background: Ink.bg;
                vertical-stretch: 1;

                VerticalLayout {
                    padding: Metric.s6;
                    spacing: Metric.s3;
                    alignment: start;

                    HorizontalLayout {
                        spacing: Metric.s3;
                        Text {
                            text: "Devices";
                            font-size: Metric.title-size;
                            font-weight: 600;
                            color: Ink.fg;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            label: "New device";
                            primary: true;
                            clicked => { root.new-device(); }
                        }
                    }

                    Rectangle { height: 1px; background: Ink.line.with-alpha(0.3); }

                    for d[i] in devices: Rectangle {
                        height: 60px;
                        background: i == root.selected ? Ink.bg-raised : transparent;

                        HorizontalLayout {
                            padding-left: Metric.s3;
                            padding-right: Metric.s3;
                            spacing: Metric.s3;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: d.name;
                                    font-size: Metric.body-size;
                                    font-weight: 600;
                                    color: Ink.fg;
                                }
                                Text {
                                    text: d.summary;
                                    font-size: Metric.label-size;
                                    color: Ink.fg-dim;
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            VerticalLayout {
                                alignment: center;
                                Button {
                                    label: "Open";
                                    clicked => { root.selected = i; root.tab = 0; }
                                }
                            }
                        }

                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Ink.line.with-alpha(0.2);
                        }

                        TouchArea { z: -1; clicked => { root.selected = i; } }
                    }

                    if devices.length == 0: Caption {
                        text: "Nothing here yet. New device builds one out of Resources.";
                    }
                }
            }

            // ── Tab 3 — resources ──
            if tab == 2: Rectangle {
                background: Ink.bg;
                vertical-stretch: 1;

                VerticalLayout {
                    padding: Metric.s6;
                    spacing: Metric.s1;
                    alignment: start;

                    for r[i] in resources: Rectangle {
                        height: r.heading ? 44px : 30px;

                        HorizontalLayout {
                            padding-left: r.heading ? 0 : Metric.s3;
                            padding-top: r.heading ? Metric.s3 : 0;
                            spacing: Metric.s3;

                            Text {
                                text: r.text;
                                font-size: r.heading ? Metric.title-size : Metric.body-size;
                                font-weight: r.heading ? 600 : 400;
                                color: r.heading ? Ink.fg : Ink.fg;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: r.detail;
                                font-size: Metric.label-size;
                                color: Ink.fg-dim;
                                vertical-alignment: center;
                            }
                        }

                        if r.heading: Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Ink.line.with-alpha(0.3);
                        }
                    }
                }
            }
        }
    }
}
