// The window — docs/GUI.md is the design this implements.
//
// **There is no sidebar.** The first cut had one, 280 px wide, holding a list that will realistically
// never exceed half a dozen entries: 25 % of the window spent on three words, which left the subject
// of the program occupying 13 % of the stage and made the whole thing read as a settings pane with a
// picture in it. Master–detail was solving a scaling problem this program does not have.
//
// The device gets the window. Switching between devices is a carousel — neighbours peek in at the
// edges, dimmed and small; the centre one is the size it deserves. That also happens to be the
// era's own idea about browsing things you own.

import { Ink, Metric } from "tokens.slint";
import { IPod } from "ipod.slint";

export struct DeviceRow {
    name: string,
    summary: string,
    state: string,
    write-target: string,
    write-target-is-warning: bool,
    chassis: color,
    dark-chassis: bool,
    parked: bool,
}

// ─── The material (§7) ──────────────────────────────────────────────────────────────────────────
//
// Used for exactly two things: the primary action, and the selected tab. Everywhere else is flat. A
// window where everything is glossy is a pastiche; a window where the one thing you are about to
// press is glossy is a 2005 idea applied with judgement.

component Material inherits Rectangle {
    background: @linear-gradient(180deg, Ink.material-top 0%, Ink.material-bottom 100%);
    Rectangle {
        y: 0;
        height: 1px;
        background: Ink.material-rule;
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> quiet: false;
    callback clicked();

    height: quiet ? 32px : 42px;
    min-width: quiet ? 104px : 148px;
    border-radius: 6px;
    background: enabled ? (quiet ? Ink.bg-raised : transparent) : Ink.bg-band-top;
    border-width: quiet ? 1px : 0;
    border-color: Ink.line.with-alpha(0.4);
    opacity: enabled ? 1.0 : 0.55;

    material := Material {
        width: 100%;
        height: 100%;
        border-radius: 6px;
        visible: enabled && !quiet;
        opacity: touch.pressed ? 0.86 : 1.0;
        animate opacity { duration: Metric.quick; }
    }

    Text {
        width: 100%;
        height: 100%;
        text: label;
        font-size: quiet ? Metric.body-size : 16px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: !enabled ? Ink.fg-disabled : (quiet ? Ink.fg : #ffffff);
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component Tab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    height: 28px;
    width: text.preferred-width + 2 * Metric.s4;
    border-radius: 5px;

    Material {
        width: 100%;
        height: 100%;
        border-radius: 5px;
        visible: active;
    }

    text := Text {
        width: 100%;
        height: 100%;
        text: label;
        font-size: Metric.body-size;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: active ? #ffffff : (touch.has-hover ? Ink.fg : Ink.fg-dim);
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// ─── The window ─────────────────────────────────────────────────────────────────────────────────

export component MainWindow inherits Window {
    title: "ipod-emulator";
    background: Ink.bg;
    // §6: below this the design does not work, so the window refuses rather than degrading into a
    // second layout nobody designed and nobody tests.
    min-width: 900px;
    min-height: 640px;
    preferred-width: 1100px;
    preferred-height: 830px;
    forward-focus: keys;

    in property <[DeviceRow]> devices;
    in-out property <int> selected: 0;
    in property <image> screen-source;
    in property <bool> running: false;

    callback start-device(int);
    callback new-device();

    property <bool> has-devices: devices.length > 0;
    property <DeviceRow> current: has-devices
        ? devices[selected]
        : { name: "", chassis: #e4e4e2, dark-chassis: false };

    // One number sets the size of everything on this surface.
    property <length> hero: min(self.height - 268px, 540px);
    property <length> hero-w: 0.5971 * hero;
    property <length> step: hero-w * 0.5 + hero-w * 0.55 * 0.5 + Metric.s7;

    public function move(delta: int) {
        if (devices.length == 0) { return; }
        selected = clamp(selected + delta, 0, devices.length - 1);
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.LeftArrow)  { root.move(-1); return accept; }
            if (event.text == Key.RightArrow) { root.move(1);  return accept; }
            if (event.text == Key.Return && root.has-devices) {
                root.start-device(root.selected);
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            // ── The only chrome (§4) ──
            Rectangle {
                height: 52px;
                background: @linear-gradient(180deg, Ink.bg-band-top 0%, Ink.bg-band-bottom 100%);
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Ink.line.with-alpha(0.5);
                }

                // No `alignment` here on purpose: setting one packs the children and makes
                // `horizontal-stretch` inert, which is why Help and About sat next to Resources
                // instead of at the far edge.
                HorizontalLayout {
                    padding-left: Metric.s5;
                    padding-right: Metric.s5;
                    spacing: Metric.s2;

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: Metric.s1;
                            Tab { label: "Devices"; active: true; }
                            Tab { label: "Resources"; active: false; }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: Metric.s1;
                            Tab { label: "Help"; active: false; }
                            Tab { label: "About"; active: false; }
                        }
                    }
                }
            }

            // ── The stage ──
            stage := Rectangle {
                background: Ink.bg;
                vertical-stretch: 1;

                VerticalLayout {
                alignment: center;
                spacing: Metric.s5;

                // The carousel. Absolute positions, animated, so the neighbours slide rather than
                // reflow — a layout that re-flows on selection is a layout that jumps (§2.2).
                Rectangle {
                    height: root.hero;
                    width: 100%;

                    for d[i] in devices: IPod {
                        body-height: i == root.selected ? root.hero : root.hero * 0.55;
                        chassis: d.chassis;
                        dark-chassis: d.dark-chassis;
                        screen-source: i == root.selected ? root.screen-source : @image-url("");
                        screen-lit: i == root.selected && root.running;
                        x: parent.width / 2 - self.width / 2 + (i - root.selected) * root.step;
                        y: (parent.height - self.height) / 2;
                        opacity: i == root.selected ? 1.0 : 0.3;
                        clicked => { root.selected = i; }

                        animate x, opacity, body-height {
                            duration: Metric.settle;
                            easing: ease-out-quart;
                        }
                    }

                    // Empty (§9): the hero iPod at rest, not a bare "nothing here".
                    IPod {
                        body-height: root.hero;
                        chassis: #e4e4e2;
                        dark-chassis: false;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        visible: !root.has-devices;
                        opacity: 0.5;
                    }
                }

                // The caption, under the device. Every row is always present so nothing moves when
                // one fills (§2.2).
                VerticalLayout {
                    spacing: Metric.s2;

                    Text {
                        text: root.has-devices ? root.current.name : "No devices yet";
                        font-size: Metric.display-size;
                        font-weight: 600;
                        color: Ink.fg;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: root.has-devices
                            ? root.current.summary
                            : "Press New device to make one — you need no iPod and no files.";
                        font-size: Metric.body-size;
                        color: Ink.fg-dim;
                        horizontal-alignment: center;
                        height: 20px;
                    }

                    // §10: whose file is about to be written to, said out loud, before the machine
                    // starts. This is what stands between an afternoon and somebody's only image of
                    // an iPod they own, so it is on the surface rather than in a settings page.
                    Text {
                        text: root.current.write-target;
                        font-size: Metric.label-size;
                        color: root.current.write-target-is-warning ? Ink.warn : Ink.fg-dim;
                        horizontal-alignment: center;
                        height: 16px;
                    }

                    HorizontalLayout {
                        padding-top: Metric.s3;
                        spacing: Metric.s3;
                        alignment: center;
                        PrimaryButton {
                            label: root.current.parked ? "Resume" : "Start";
                            enabled: root.has-devices;
                            clicked => { root.start-device(root.selected); }
                        }
                        if root.current.parked: PrimaryButton {
                            label: "Cold boot";
                            quiet: true;
                            clicked => { root.start-device(root.selected); }
                        }
                        PrimaryButton {
                            label: "New device";
                            quiet: true;
                            clicked => { root.new-device(); }
                        }
                    }

                    // Where you are in the carousel. Only earns its place past one device.
                    HorizontalLayout {
                        padding-top: Metric.s4;
                        spacing: Metric.s2;
                        alignment: center;
                        height: 8px;
                        visible: devices.length > 1;

                        for d[i] in devices: Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 3.5px;
                            background: i == root.selected ? Ink.accent : Ink.line.with-alpha(0.4);
                            animate background { duration: Metric.settle; }
                        }
                    }
                }
                }
            }
        }
    }
}
