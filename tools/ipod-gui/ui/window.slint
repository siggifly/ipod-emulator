// The window — docs/GUI.md is the design this implements.
//
// **The iPod is not a picture inside the program. It is the program.** One well, one device drawn at
// its own true size, one fixture holding it, one shelf under it that speaks, one drawer beside it
// that holds everything else. Pressing the device's own centre button is what starts it.
//
// **There is no chrome bar, no tab strip, no Start button and no settings screen** (§4). Every one
// of those is a thing standing between a person and the object they came to look at, and all four
// were in the file this replaces: a 56 px band of five tabs, a carousel that animated `body-height`
// on a live framebuffer (§18.1), a four-line caption stack repeating the name of the device drawn
// 656 px tall above it, and a Resources list nothing could act on.
//
// **What this file is now.** It owns three things and composes the rest:
//
//   1. the four window size constants, which are plain `Geometry` reads and must never see `hero`;
//   2. the push — one animated `drawer-inset` that the well, the handle and the drawer all read, so
//      the drawer cannot slide at one speed while the well narrows at another;
//   3. the keyboard, whose `Esc` has exactly ONE definition and it lives in Rust (`nav::Stack`).
//
// Everything drawn is `Bench` (§7) or `Drawer` (§4, §11); everything decided is `nav.rs`, `rail.rs`
// and the model in `eapp-loader`. This file states no policy and words no sentence.

import { Ink, Metric, Motion } from "tokens.slint";
// Generated by build.rs from src/geometry.rs (§16.9). Every ratio and every size constant on this
// page comes from there, so a test cannot hand-copy one and stay green.
import { Geometry } from "@geometry";
import { Bench, CradleRing } from "bench.slint";
import { Drawer, DrawerHandle, DrawerPage } from "drawer.slint";
import { RailRow } from "rail.slint";

// **LOAD-BEARING, and it is easy to miss.** A global reaches the generated Rust only if it appears
// in the export list of the document the compiler was given as the ROOT
// (`i-slint-compiler-1.17.1/passes/check_public_api.rs:92-99`, and `llr/lower_to_item_tree.rs:1015`
// sets `exported: !exported_global_names.is_empty()`). *Importing* `Motion` above is not enough.
// Without this line `MainWindow::global::<Motion>()` does not exist and the failure reads as a
// missing method rather than as a missing export — `main.rs` pushes §8.4's reduced-motion scale
// through one and §16.6's single font family through the other.
export { Motion, Metric } from "tokens.slint";

// One device, flattened for the markup. **Every string on it is the model's**, built in `main.rs`
// out of `settings.rs` — this file never words one, which is what stops the window and the model
// disagreeing about what a device is.
//
// `ResourceRow` went with the Resources tab. Its one test —
// `no_row_claims_a_verification_the_model_did_not_record` — was re-expressed onto
// `Provenance::line()` rather than dropped (§16.10), and is still in `main.rs`.
export struct DeviceRow {
    name: string,
    summary: string,
    state: string,
    write-target: string,
    write-target-is-warning: bool,
    chassis: color,
    dark-chassis: bool,
    // §7.3: can the cradle hold this one? False where a part of it has left the library, which is
    // the refusal §20 item 1 already produces and §20 item 12 requires somewhere to show.
    startable: bool,
    // §7.3's label: what pressing will cost, or why it cannot be pressed. The model's sentence,
    // verbatim.
    cradle-label: string,
}

export component MainWindow inherits Window {
    title: "ipod-emulator";
    // Never seen: the bench paints every pixel of the client and the drawer paints its own. It
    // matches the well so that a frame in which the layout has not settled is the well's colour
    // rather than a white flash.
    background: Ink.bg-sunken;

    // ── The four size constants, and the sentence that stops somebody tidying them ──
    //
    // **These are plain constants and they must never read `hero`** (§16.1). The window's height
    // comes from its layout, the layout from the content, the content from `hero` — so binding
    // either height to the body closes the loop and it oscillates. `preferred-height: root.hero +
    // Geometry.chrome-pref` is arithmetically the truest thing anybody could write here and is
    // exactly the trap. Slint reports the inherited case as a **deprecation warning** saying it may
    // panic at run time, gated on a flag that defaults to false and that `slint-build` exposes no
    // setter for, so the compiler will not fail the build — `the_window_constants_do_not_read_the_
    // hero` is what does.
    //
    // A `Geometry` property is a leaf in the dependency graph: it reads nothing, least of all the
    // layout. `min-height` is a **floor** — the height below which §9.5's replacement pane cannot be
    // laid out — not a height that holds the device; a minimum that guaranteed the 1:1 panel would
    // have to vary with `k` and `sf`, and a window minimum is a constant.
    min-width: Geometry.min-width;
    min-height: Geometry.min-height;
    preferred-width: Geometry.pref-width;
    preferred-height: Geometry.pref-height;
    forward-focus: keys;

    // ── The library ──
    in property <[DeviceRow]> devices;
    // §9.1: an empty library is a state with something to say, not an absent one. The sentence is
    // the model's — pushed as a whole row from `main.rs` — rather than a struct literal written
    // here, which is how the previous revision came to invent `chassis: #e4e4e2` in markup.
    in property <DeviceRow> empty-device;
    // §10.1: the drawn iPod in `Colour::Unspecified` at 45 % — **an iPod that has not been decided
    // yet**, which is what an empty bench has. Not black: drawing an unknown chassis black invents
    // a fact.
    //
    // **Pushed from Rust rather than derived here as `!root.has-devices`**, and the difference is
    // not cosmetic. It is an *emptiness* state today — §9.1 gives the later-empty bench the same
    // ghost — but §10.2 wants the body to cross-dissolve to solid the moment `Source::identity()`
    // answers, which is **before** the device is in the list. A markup expression over
    // `has-devices` would have to be unpicked to get there; a pushed boolean is already the right
    // shape.
    in property <bool> ghost: false;
    // §9.2's bench mirror: *"the cradle label carries `building · 41 % · fetching Rockbox 4.0`"*.
    //
    // Empty means nothing is running, and then the row's own label stands. It is a second property
    // rather than an override written into `DeviceRow.cradle_label` because a `DeviceRow` is
    // rebuilt only when the **library** changes, and work moves ten times a second — so the sentence
    // that moves and the sentence that does not come from two places, and only one of them is
    // pushed on every tick.
    in property <string> working-label;
    in-out property <int> selected: 0;
    in property <image> screen-source;
    in property <bool> running: false;

    // ── What Rust measures and pushes in (§6.6, §16.1) ──
    //
    // `hero` is the body height in LOGICAL pixels: `k × 655.751 / sf`, where `k` is a whole number
    // decided from the measured display and the scale factor. It is an `in property` rather than a
    // constant because that whole number cannot be known until there is a window on a display — and
    // it is never read back out of the markup, which is what keeps the arrow pointing one way.
    //
    // The default is the k = 1, sf = 1 case so that `slint-viewer` and the live preview still draw a
    // plausible device with no Rust running.
    in property <length> hero: Geometry.hero-phys-1x;
    // The panel, in logical pixels, walked up by ULPs until it survives the round-trip through f32
    // (§6.6, "the f32 tail"). **Pushed and not yet read**: `IPod` derives the panel from
    // `body-height` and the generated ratios, which is the same number by a different route, and a
    // second route is only worth having when something needs the exact logical value — the
    // screenshot key (§17) is the first thing that will.
    in property <length> screen-w;
    in property <length> screen-h;
    // The same `k` the panel is drawn at, as an integer. **Pushed and not yet read**, for the same
    // reason as the two lengths above: `IPod` derives the panel from `body-height`, and a second
    // route is only worth having when something needs the whole number itself. The screenshot key
    // (§17) is the first thing that will, because a 1:1 PNG has to know what to divide by.
    in property <int> screen-scale: 1;
    // §9.5: this display cannot show the panel at 1:1. Computed in Rust with hysteresis and pushed
    // in, because Slint has no responsive breakpoints and cannot have any. The replacement pane that
    // reads it is §9.5's, which is not built — this is the input waiting for it, not a claim that
    // the state is drawn. `the_too_short_state_is_an_input_with_nothing_reading_it` asserts the gap
    // and retires itself the moment the pane lands.
    in property <bool> too-short: false;
    // §17.Q12, measured: how wide the longest Rail verb actually draws at `Metric.body-size` in the
    // face this platform gave us. **Read out, never in** — it is the one number in this program that
    // only the text renderer knows, and `Geometry.rail-verb-w` is a budget until it is compared
    // against this. `IPOD_LAYOUT=1` prints it and `tests/startup_fit.rs` asserts on it.
    out property <length> verb-width: verb-probe.preferred-width;
    // §7.5's row-2 trailing slot: the one number a bug report can quote.
    in property <string> fidelity;
    // §7.3: the drawn device is the picture, and this is what an assistive technology is told is on
    // its panel. The machine's, not the program's.
    in property <string> panel-description;
    // §7.4: the centre button's hit region is `wheel::WheelRing::select`, which is 39 % wider than
    // the drawn disc. **The ratio lives in `wheel.rs`** — two rules for that region is exactly what
    // §7.4 records as having disagreed with each other and with the model — so Rust pushes the
    // diameter and neither this file nor `ipod.slint` re-derives it. The default is the drawing's
    // own diameter: a smaller target, never a wrong one.
    in property <length> select-d: Geometry.centre-d * root.hero;

    // ── Where you are (§4, §16.8) ──
    //
    // **`in`, not `in-out`.** `nav::Stack` in Rust is the single writer; the markup fires callbacks
    // and never writes these. Four entrances plus `Esc` writing the same state from two sides is how
    // `Esc` came to have three meanings.
    in property <bool> drawer-open: false;
    in property <int> drawer-depth: 0;
    in property <DrawerPage> drawer-page: DrawerPage.none;

    // ── The Rail and the Work page (§9.2, §9.3, §10.1) ──
    in property <[RailRow]> rail;
    in property <int> rail-failures: 0;
    in property <string> rail-announce;
    // §6.5: the index of the one Rail entry allowed to wear the material, or -1.
    in property <int> rail-first-failure: -1;
    // §7.5's row 2, when the Rail has something to say. Empty otherwise, and the facts stand.
    in property <string> rail-line;
    in property <string> work-heading;
    in property <string> work-empty;
    in property <string> ledger-download;
    in property <string> ledger-disk;
    in property <string> ledger-note;
    in property <bool> ledger-warn: false;
    // §9.2, §12.3: the shelf's 3 px bar, drawn ON the shelf's top rule so it costs no height.
    //
    // **The sign is load-bearing: negative means there is no denominator**, so there is no bar — a
    // number that moves instead. A bar with an invented denominator is a lying instrument, and a
    // cold boot has no honest one until this device has completed one.
    //
    // `Bench` has declared this since the drawer landed and `bench.slint` draws it; until now
    // nothing bound it, which is a drawn instrument with no producer — the shape §20 item 15 names.
    in property <float> progress: -1;

    callback start-device(int);
    // §7.6's `why ›`: put this device's refusal on the Rail, then open the page that owns it.
    callback explain(int);
    callback escape-pressed();
    callback drawer-toggled();
    callback open-page(DrawerPage, int);
    callback drawer-back();
    callback rail-next(int, int);
    callback rail-dismiss(int);
    callback rail-cancel(int);
    callback copy-text(string);

    property <bool> has-devices: root.devices.length > 0;
    property <DeviceRow> current: root.has-devices ? root.devices[root.selected] : root.empty-device;

    // ── The push (§4, §7.5, §8.1 item 1) ──
    //
    // **One animated number, read by three things.** The well narrows, the handle rides the well's
    // trailing edge, the drawer slides in — and because all three read the same property they cannot
    // disagree about where the edge is mid-animation. The drawer's own **width never animates**, so
    // its text never reflows; only its `x` moves, and the device moves because the well did.
    property <length> drawer-inset: root.drawer-open ? Geometry.drawer-w : 0;
    animate drawer-inset {
        duration: Motion.gentle;
        easing: ease-out-quart;
    }
    // **On stage**, which is not the same as open: true from the moment it starts opening until the
    // close animation has finished. The drawer gates its pages' `visible` on it, so a closed drawer
    // is out of the tab order and out of the accessible tree instead of sitting 420 px off screen
    // being announced — and a closing one still draws its contents while it leaves.
    property <bool> drawer-on-stage: root.drawer-open || root.drawer-inset > 0;

    public function move(delta: int) {
        if (root.devices.length == 0) {
            return;
        }
        root.selected = clamp(root.selected + delta, 0, root.devices.length - 1);
    }

    // §7.3: the cradle is the Button, so it is what the window hands focus to. Without this the
    // window opens with focus on the root scope, where Return means nothing, and the one control the
    // whole program is built around is a Tab away with no ring on it.
    init => {
        bench.focus-cradle();
    }

    keys := FocusScope {
        // ⌘ is delivered as `Control` on Apple platforms
        // (`i-slint-backend-winit-1.17.1/event_loop.rs:259-274`), so one column covers both. The
        // modifier names are exactly `Alt` / `Control` / `Meta` / `Shift` and nothing else; `Cmd`
        // and `Command` are hard errors. `Comma` is `LocalizedShiftable` and sets `ignore_shift`
        // itself, so adding `Shift` to it is a hard error too.
        // **It opens the menu, not Reference, and that is not a placeholder.** §7.5 lists `⌘,` as one
        // of the four routes in and the key is right; its destination is not built. Pointing it at
        // depth 1 / Reference navigated to a slot containing no page — 420 px of `bg-raised` with no
        // header and therefore no visible way out — and bypassed the very row that states the gap
        // (`MenuPage`'s Reference row is disabled with *"The keyboard table and the stated limits
        // have no page yet."*). Every other unbuilt page in this program is unreachable and says why;
        // this was the one hole in that policy.
        //
        // Retirement condition: when a Reference page exists in the depth-1 slot, this becomes
        // `open-page(DrawerPage.reference, 1)` again.
        KeyBinding {
            keys: @keys(Control + Comma);
            activated => {
                root.open-page(DrawerPage.none, 0);
            }
        }
        // `BackSlash` has a capital S. Two KeyBindings under one FocusScope with the same keys is a
        // hard error, which is the one thing about this element that fails loudly.
        KeyBinding {
            keys: @keys(Control + BackSlash);
            activated => {
                root.drawer-toggled();
            }
        }

        // **`Esc` is not handled here, only reported.** §16.8 gives it one definition and it lives
        // in `nav::Stack::escape` — outwards, in one order: leave fullscreen, close an Expand, go
        // back a level, close the drawer, then park or power off. A second definition in markup is
        // how it came to have three.
        //
        // Everything else bubbles (`return reject`): Space and Return belong to whichever control
        // has focus, and ↑/↓ belong to the machine's wheel, always.
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.escape-pressed();
                return accept;
            }
            // **Only while the drawer is closed.** These pick which device the bench draws, and
            // every `FocusScope` below returns `reject` for an arrow — so with the drawer open they
            // bubbled all the way up here from a focused drawer row and silently swapped the device
            // behind the drawer, including the one `start-device(root.selected)` would start. §7.2
            // puts device selection on the Devices drawer page; this is the bench's own shortcut and
            // it belongs to the bench.
            if (!root.drawer-open && event.text == Key.LeftArrow) {
                root.move(-1);
                return accept;
            }
            if (!root.drawer-open && event.text == Key.RightArrow) {
                root.move(1);
                return accept;
            }
            return reject;
        }

        // The client area. It exists so the drawer can be told the height it has to fit in without
        // anything reading the window's own height — `root.height` is banned in markup and
        // `nothing_in_the_markup_reads_the_windows_own_height` is the mechanical form of that.
        //
        // `clip` because the drawer parks at `x == client.width`, fully outside: an unclipped
        // element is still drawn past its parent's bounds.
        client := Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            clip: true;

            // ── The one thing in this markup that measures rather than draws ──
            //
            // `Geometry.rail-verb-w` is 88 px, derived from a **budget** — `geometry::BODY_ADVANCE`,
            // an average glyph advance nobody has measured against the system face this program
            // cannot interrogate. §17.Q12 named it as the one constant nobody measured and predicted
            // its failure exactly: the longest verb is `synthesise`, it appears at first-run step 1,
            // and if it elides it elides on the first thing a new person ever sees this program do.
            //
            // There is no Rust-side text-measurement API in Slint 1.17, so the measurement is taken
            // where text is measured — by a `Text` — and read back out through an `out property`.
            // It is `visible: false` and outside every layout, so it draws nothing and moves
            // nothing; §16.3's rule that `visible: false` still reserves layout space is exactly why
            // it is positioned absolutely rather than put in a row.
            //
            // `tests/startup_fit.rs` launches the real binary, reads this off `IPOD_LAYOUT=1`, and
            // compares it against the constant — with the real font, on a real display, which is
            // the only place the answer exists.
            verb-probe := Text {
                x: 0;
                y: 0;
                visible: false;
                // The longest of the six `ui/rail.slint` names, and it is the one first run draws.
                text: "synthesise";
                font-size: Metric.body-size;
                font-weight: Metric.weight-body;
            }

            // §7. Full width, always: §9.5's decision is that the shelf's band and its 1 px top rule
            // span the whole client and only the shelf's three content rows narrow, because a drawer
            // that is full client height above an 88 px shelf otherwise leaves the bottom-right
            // 420 × 88 belonging to nothing. So the bench is handed the inset and narrows its own
            // well; it is never given a smaller width.
            bench := Bench {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;

                drawer-inset: root.drawer-inset;
                drawer-open: root.drawer-open;

                hero: root.hero;
                select-d: root.select-d;
                chassis: root.current.chassis;
                dark-chassis: root.current.dark-chassis;
                ghost: root.ghost;
                screen-source: root.screen-source;
                screen-lit: root.running;
                panel-description: root.panel-description;
                // §9.2's one line on the bench, and §12.3's honesty about it.
                progress: root.progress;

                // §12.2's four phases, and this build is in the first of them: `Off`. Every drawn
                // control on the device is gated on this and says so when pressed (§7.4), rather
                // than being drawn disabled or silently doing nothing.
                has-machine: root.running;

                device-name: root.current.name;
                // §9.2: while something is happening, the cradle carries it. The row's own label
                // says what pressing will cost or why it cannot be pressed (§7.3), and neither of
                // those is what a person wants to read during a download.
                cradle-label: root.working-label != "" ? root.working-label : root.current.cradle-label;
                // §6.4, and this is **three colours and one shape, not four colours**: `accent` when
                // startable, `fg-dim` otherwise, `danger` only when a machine has **stopped**, and a
                // **broken ring** when the device cannot start. The first cut painted a refusal
                // `danger`, which spent the one colour that means *a machine died* on *a file moved*
                // — and would have left nothing to distinguish them the day `Stopped` lands. §7.3's
                // table gives all three `cannot start` rows `fg-dim` + broken ring; the only `danger`
                // row in it is `stopped — Lost(0xe19b0000)`.
                //
                // `CradleRing.danger` is therefore **unused until §12.2's `Stopped` exists**, which
                // is a state this build cannot be in. Retirement condition: `phase()` answers
                // `Stopped`, and this binding gains the arm rather than borrowing it.
                //
                // **`has-devices` is gone from THIS expression and deliberately kept in the next
                // one**, and the two gates were the same by accident rather than by decision.
                // §10.1 and §9.1 both give the empty bench an `accent` cradle: there is exactly one
                // thing to press on that screen and the fixture is what says so. `startable` is the
                // model's answer for a real device *and* for the empty one — `empty_device` computes
                // it from the same predicate the press consults — so one boolean drives the ring,
                // the announcement and what pressing does, and they cannot disagree.
                cradle-ring: root.current.startable
                    ? CradleRing.accent
                    : CradleRing.dim;
                // A cradle that cannot hold the device has gaps in it — the drawing saying the
                // thing. **An empty bench is not broken, it is empty**, so this keeps `has-devices`:
                // a refused *device* gets a broken ring (§7.3's three `cannot start` rows), a
                // refused *empty bench* gets an unbroken `fg-dim` one, because there is no device
                // for the fixture to have failed to hold.
                cradle-broken: root.has-devices && !root.current.startable;
                startable: root.current.startable;

                shelf-name: root.current.name;
                shelf-state: root.current.state;
                shelf-facts: root.current.summary;
                // §7.5's row 2 has three tenants and one line. `Rail::line()` decides between the
                // last two — a failure outranks work in progress — and Rust pushes the answer.
                shelf-rail-line: root.rail-line;
                shelf-refusal: root.has-devices && !root.current.startable;
                shelf-fidelity: root.fidelity;
                shelf-write-target: root.current.write-target;
                shelf-write-warn: root.current.write-target-is-warning;

                // **The point of the whole program.** The drawn centre button, and the cradle's
                // keyboard route to the same callback, both land here; Rust resolves the device and
                // either starts it or files the refusal in the Rail (§20 item 12).
                pressed-centre => {
                    root.start-device(root.selected);
                }
                open-drawer => {
                    root.drawer-toggled();
                }
                // §7.6: the shelf elides a refusal to one line and this opens the drawer at the page
                // that owns it, where the paragraph and its next steps live **under the control that
                // caused them**. Today that is Work, which is the page the Rail is on — and the
                // index goes with it, because opening Work on an empty Rail is a route the design
                // describes as leading to the explanation leading instead to *"Nothing is
                // happening."* Rust files the refusal for this device before it opens the page.
                why => {
                    root.explain(root.selected);
                }
                // `wheel-down` / `wheel-moved` / `wheel-up` / `hold-toggled` are declared by `Bench`
                // and deliberately left unbound: `IPod` raises none of them without a machine, and
                // wiring a handler to a stream that cannot arrive is the phantom route §19.1
                // indicts. They arrive with `emu::Link`.
            }

            // §7.5, and it rides the well rather than the window edge — which is what makes it read
            // as the drawer's own handle rather than as a tab stuck to the frame.
            handle := DrawerHandle {
                open: root.drawer-open;
                x: client.width - root.drawer-inset - Geometry.handle-w;
                y: (client.height - Geometry.shelf - Geometry.handle-h) / 2;
                toggled => {
                    root.drawer-toggled();
                }
            }

            // §4: 420 px, right-anchored, full client height **above the shelf**. Parked one full
            // width off the right edge when closed, so `x` is the only thing that ever moves.
            drawer := Drawer {
                x: client.width - root.drawer-inset;
                y: 0;
                client-height: client.height;

                open: root.drawer-on-stage;
                depth: root.drawer-depth;
                page: root.drawer-page;
                rail-failures: root.rail-failures;

                rail: root.rail;
                rail-announce: root.rail-announce;
                rail-first-failure: root.rail-first-failure;
                work-heading: root.work-heading;
                work-empty: root.work-empty;
                ledger-download: root.ledger-download;
                ledger-disk: root.ledger-disk;
                ledger-note: root.ledger-note;
                ledger-warn: root.ledger-warn;

                close => {
                    root.drawer-toggled();
                }
                back => {
                    root.drawer-back();
                }
                go(page, depth) => {
                    root.open-page(page, depth);
                }
                rail-cancel(id) => {
                    root.rail-cancel(id);
                }
                rail-dismiss(id) => {
                    root.rail-dismiss(id);
                }
                rail-next(id, n) => {
                    root.rail-next(id, n);
                }
            }
        }
    }
}
