// The drawer's root page — docs/GUI.md §21.3, §21.6, §14.1, §9.4.
//
// **It replaces `MenuPage`, which was three nouns over four inventories.** `iPods`, `Games` and
// `Settings` were destinations; behind the first was a key/value inspector that stated six facts
// before it offered one verb, with `Start` at the bottom of the stack under the destructive
// `Remove`. Nobody arrives at this program wanting a bootloader.
//
// **This file words nothing.** Every label, every value, every refusal and every escape hatch on
// this page is `src/verbs.rs`'s, pushed as a `VerbRow` — including the ones that page fetches from
// somewhere else rather than writing itself. A sentence typed here would be a second wording for
// an iPod the bench is already describing, which is the drift §16.9 exists to delete.
//
// **The rule between the bands is a row property, not a count.** `rule-above` comes off
// `verbs::Verb::group()`, so §21.3's horizontal line moves when the groups move and no markup file
// knows how many rows are above it — which matters because the developer switch removes four.
//
// **`About this iPod` is last and it is not a control.** §21.3 demotes the six-row fact table under
// the verbs rather than deleting it: it is honest and this project values that over tidiness. It is
// drawn with `MadeOfLine`, the same component the Devices page uses, from `devices::facts`, the
// same producer — one table, one wording, two surfaces.

// **One `@geometry` read and no literal beside it** — the fact table's own inset, because
// `MadeOfLine` carries no padding of its own while every `Row` on this page does.
// `no_geometry_literal_survives_in_the_markup` is what stops that becoming a typed 24.
import { Ink, Metric } from "tokens.slint";
import { Geometry } from "@geometry";
import { DetailRow, DrawerHeader, Row, Scroll, SwitchRow, VerbRow } from "primitives.slint";
import { MadeOfLine } from "devices.slint";

export component VerbsPage inherits Rectangle {
    /// §21.3's list, in order, already filtered by the developer switch.
    in property <[VerbRow]> rows;
    /// §21.3's demoted facts — `devices::facts`, the Devices page's own six.
    in property <[DetailRow]> about;
    /// The heading over them. A string rather than a literal for this file's own rule: the page
    /// words nothing, and `About this iPod` is a name for a device the model knows about.
    in property <string> about-heading;

    callback close();
    /// The ordinal off the row, never the repeater index — see `VerbRow.verb`.
    callback act(int);

    background: Ink.bg;

    VerticalLayout {
        spacing: 0px;

        DrawerHeader {
            back: "Close";
            title: "Menu";
            back-pressed => {
                root.close();
            }
        }

        // **It scrolls, and at this length it has to.** Thirteen verb rows with the developer
        // switch off, seventeen with it on, plus a heading and six facts — and a disabled
        // `Pressable` is `ROW_H + FIELD_REASON` tall because §9.4's reason slot is reserved under
        // it, so a page where the machine is off draws four of §21.6's five at 78 px. Without a
        // Scroll the tail is not merely invisible: a clipped item is out of the accessible tree
        // and `WindowInner::move_focus` cannot recover it, because the drawer clips with a
        // Rectangle rather than a Flickable.
        scroll := Scroll {
            vertical-stretch: 1;
            min-height: 0px;
            preferred-height: 0px;
            viewport-height: body.preferred-height;

            body := VerticalLayout {
                width: scroll.width;
                alignment: start;
                spacing: 0px;
                accessible-role: AccessibleRole.list;
                accessible-label: "Menu";

                for r[i] in root.rows: VerticalLayout {
                    spacing: 0px;

                    // §21.3's band break, drawn wherever the group changes. `if` rather than
                    // `visible`, because this element holds no state to throw away — §16.3's rule
                    // is about subtrees with focus, hover or a scroll offset in them, and a rule
                    // and its air have none.
                    //
                    // **Air first, then an inset hair** (§23, 2026-09-07). It was a full-bleed
                    // 1 px `Ink.line` and nothing else, and on the page that is four groups drawn
                    // as three identical dividing lines between fourteen rows of identical height —
                    // a table with horizontal rules, which is what a spreadsheet looks like and not
                    // what a list looks like. The break a reader actually feels is the **gap**; the
                    // hair is there so the gap cannot be mistaken for the page having ended, which
                    // is the failure a gap alone has at the bottom of a scroll.
                    //
                    // The hair starts at the page margin rather than at the window's edge, so it
                    // runs under the labels it is separating instead of across the whole surface.
                    // That is the one construction that reads as *these rows are one group and
                    // those are another* rather than as *here is a line*.
                    if r.rule-above: Rectangle {
                        height: Metric.s5;
                        background: Ink.bg;

                        Rectangle {
                            x: Geometry.page-margin;
                            y: (parent.height - self.height) / 2;
                            width: parent.width - 2 * Geometry.page-margin;
                            height: 1px;
                            background: Ink.separator;
                        }
                    }

                    // ── The hair between two rows of one group ───────────────────────────────
                    //
                    // **Without it this page is not a list, it is a column of text** (§23). Rows
                    // here are 44, 60 or 78 px depending on whether they carry a price or a
                    // refusal, so the labels do not fall on a regular pitch and there was nothing
                    // else saying where one row ended and the next began — `_out/gui/menu.png`
                    // reads as loose paragraphs with a switch in the middle of them.
                    //
                    // It is the **same hair** the band break draws, at the same inset, and that is
                    // the point rather than a saving: a group break is then *this hair plus air*
                    // and a row break is *this hair*, so the two are one vocabulary and the air is
                    // what distinguishes them. Two different lines would be two claims about how
                    // much of a break each one is.
                    //
                    // Drawn above each row rather than below it, and never above the first — the
                    // row that opens a group already has the band break's hair over it, and a
                    // second one there would be two lines with 24 px between them.
                    // The outer `Rectangle` is a layout cell one pixel tall and the inner one is the
                    // hair inside it — the same two-element shape the band break uses, because a
                    // child of a `VerticalLayout` is positioned by the layout and cannot inset
                    // itself.
                    if i > 0 && !r.rule-above: Rectangle {
                        height: 1px;
                        background: Ink.bg;

                        Rectangle {
                            x: Geometry.page-margin;
                            width: parent.width - 2 * Geometry.page-margin;
                            height: 1px;
                            background: Ink.separator;
                        }
                    }

                    // **Two arms, one row, and the branch is a role rather than a drawing.**
                    // §22.4's power row is drawn by `Row` exactly as the other thirteen are — the
                    // pill lives in the value column's trailing gutter, beside the chevron's — and
                    // what `SwitchRow` adds is the accessible role, which Slint requires to be a
                    // constant expression and so cannot be bound from `r.switch`.
                    //
                    // `if` rather than `visible` because only one of the two may be in the
                    // accessible tree at a time, and because neither holds state to throw away:
                    // every property on both comes from `r`, and the focus a `Scroll` cares about
                    // is re-established by `gained-focus` either way.
                    if !r.switch: Row {
                        index: i;
                        count: root.rows.length;
                        label: r.label;
                        value: r.value;
                        sub: r.sub;
                        chevron: r.chevron;
                        enabled: r.enabled;
                        reason: r.reason;
                        machine-rule: r.machine-rule;
                        escape-hatch: r.escape-hatch;
                        activated => {
                            root.act(r.verb);
                        }
                        gained-focus => {
                            scroll.ensure-visible(self.absolute-position.y, self.height);
                        }
                    }

                    if r.switch: SwitchRow {
                        index: i;
                        count: root.rows.length;
                        label: r.label;
                        value: r.value;
                        sub: r.sub;
                        on: r.on;
                        enabled: r.enabled;
                        reason: r.reason;
                        machine-rule: r.machine-rule;
                        escape-hatch: r.escape-hatch;
                        activated => {
                            root.act(r.verb);
                        }
                        gained-focus => {
                            scroll.ensure-visible(self.absolute-position.y, self.height);
                        }
                    }
                }

                // ── §21.3: the facts, demoted ────────────────────────────────────────────────
                //
                // Drawn only where there is a device to describe. §9.1 forbids a bare *nothing
                // here*, and an empty library already has its sentence on the row above — the
                // heading and six blank facts under it would be that sentence contradicted.
                // **The same break the bands get, and for a stronger reason** (§23). What is
                // below is not another band of the list — it is a description of a device, in a
                // two-column grammar the fourteen rows above do not use. A 1 px full-bleed rule
                // said *next section*; the air says *different kind of thing*, which is what this
                // is.
                if root.about-heading != "": Rectangle {
                    height: Metric.s5;
                    background: Ink.bg;

                    Rectangle {
                        x: Geometry.page-margin;
                        y: (parent.height - self.height) / 2;
                        width: parent.width - 2 * Geometry.page-margin;
                        height: 1px;
                        background: Ink.separator;
                    }
                }

                if root.about-heading != "": Row {
                    index: root.rows.length;
                    count: root.rows.length + 1;
                    label: root.about-heading;
                    heading: true;
                }

                // **The heading's own leading, and the block's trailing air.** §6.3's `s2` between
                // a heading and what it heads, and `s5` under the last fact so the list does not
                // end flush against the bottom of the scroll — which read as the page having been
                // cut off rather than having finished. Both are spacers rather than padding on
                // `MadeOfLine`, because that component's row height is pinned to
                // `Geometry.line-label` by `every_fact_this_page_draws_is_drawn_whole`'s control
                // and leading inside it would make every one-line fact measure tall.
                if root.about-heading != "": Rectangle {
                    height: Metric.s2;
                }

                // **Inset by the page margin, because `MadeOfLine` has none of its own.** Every
                // `Row` above carries `pad: Geometry.page-margin` inside itself; a `MadeOfLine`
                // relies on the body it is laid out in, which on the Devices page is padded and
                // here is not. Without this the fact labels start 24 px to the left of every row
                // above them — read it off `_out/gui/menu-tall.png`, where `iPod` and `Drive` sat
                // outside the column `Apple's software` and `Settings` stand in.
                for d[i] in root.about: MadeOfLine {
                    d: d;
                    index: i;
                    x: Geometry.page-margin;
                    width: parent.width - 2 * Geometry.page-margin;
                    // **Nothing is bound to `act`**, and that is §21.3's *demoted, not deleted*
                    // as a wiring decision: `devices::facts` returns the six facts and the machine
                    // rules and no acts at all, so `d.has-action` is false on every row here and
                    // the branch that would fire this is not drawn. Binding it would be a route
                    // into `RowAction` from a page whose subject is a description.
                    reveal(y, h) => {
                        scroll.ensure-visible(y, h);
                    }
                }

                // The block's trailing air — see the heading's leading, above.
                if root.about-heading != "": Rectangle {
                    height: Metric.s5;
                }
            }
        }
    }
}
