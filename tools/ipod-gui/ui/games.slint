// Games — docs/GUI.md §13, §13.4, §9.1.
//
// **The page exists because the shelf and the drawer both point at it.** §7.3 designs all five
// menu-strip words to call `open-page(<its page>, 1)`, and
// `every_word_of_the_menu_strip_opens_the_drawer_at_the_page_it_names` enforces it — so `Games` is
// navigable by design. It had no body: every other page in `ui/drawer.slint` carries a
// `visible: … && root.page == DrawerPage.<name>` block and this one did not, so pressing the word
// opened a blank drawer and nothing said why.
//
// **It was a project state and it is not one any more, and this header said otherwise for as long
// as nobody read it against the page under it.** The two paragraphs that stood here described a
// page whose whole content was §13.4's sentence about 0.6 — *what must NOT appear here is a title
// list this program cannot open* — and what is below is a title list this program opens: the rows
// fire `play(i)`, `main::on_games_play` reaches `start_title`, and a title runs on the bench with
// the drawn wheel driving it. A comment describing a mechanism that is not there is the next
// drift, so it is corrected rather than deleted (AGENTS.md §7).
//
// **What §13 still designs and this page still does not have** is the binding matrix — `61 of 98`
// in `warn`, per-import resolution — because that is the framework work §15 puts in 0.6, and the
// keystore is in a private repository. The shelf, the list and the press arrived ahead of it.
//
// §9.1 is what the empty state below obeys: an empty page and a page that has not been pointed
// anywhere look identical, and only one of them is the operator's to fix.

import { Ink, Metric } from "tokens.slint";
import { Geometry } from "@geometry";
import { DrawerHeader, Row, Scroll, Tile, TitleRow } from "primitives.slint";

export component GamesPage inherits Rectangle {
    callback back-pressed();
    /// The titles found where [`Settings::games`] points, by name.
    in property <[TitleRow]> titles;
    /// Where that is, drawn on the row that changes it. Empty when nothing has been chosen.
    in property <string> folder;
    /// **A shelf was chosen and it is not there any more** — moved, renamed, or on a drive that is
    /// not plugged in. The library references files rather than copying them, so this is the one
    /// failure that model has, and it is the operator's to fix rather than ours to hide. Without
    /// it the row below blames the folder's *contents* for a folder that is gone.
    in property <bool> folder-gone;
    /// Ask for a folder of titles. §13's own words: a title is a thing that stands on the bench,
    /// so this is how one gets onto it.
    callback choose();
    /// Run this title. The index is into `titles`, because a name is not a key: two shelves can
    /// hold the same game.
    callback play(int);

    /// **Which tile the first press armed, and `-1` for none** — §22.5's double-press.
    ///
    /// It lives on the page rather than inside `Tile` so there is one writer: a tile that
    /// remembered its own arm would let two be armed at once, and the second press would then be
    /// ambiguous about which title it was the second press *of*. `Pressable` keeps its own `armed`
    /// for the same rule read the other way — it is one control, so it is its own page.
    ///
    /// **It is not reset when the shelf changes**, and that is deliberate rather than overlooked:
    /// `refresh_titles` re-pushes the model on every save, and an arm cleared by a background
    /// re-push would be a press that stopped counting because something else happened. What clears
    /// it is a second press, or a press on another tile.
    property <int> armed: -1;

    /// §22.5's two columns, and the rows that follow from the shelf's length.
    ///
    /// **Read off `Geometry` rather than typed**, so the count that lays the covers out and the
    /// count the viewport is sized from cannot come apart — which is the arithmetic bug a grid
    /// invites and the one thing that would scroll a shelf to the wrong place.
    /// **A `float` rather than an `int`, and both halves of that matter.** `Geometry.cover-cols` is
    /// a `Ratio`, so it arrives as one; and `length / cols` under integer division would answer 1
    /// for three titles in two columns, which is a viewport one row short and a third cover drawn
    /// past the bottom of a container that neither shrinks nor clips it (§16.2).
    property <float> cols: Geometry.cover-cols;
    property <float> rows: Math.ceil(root.titles.length / root.cols);

    background: Ink.bg;
    accessible-role: AccessibleRole.region;
    accessible-label: "Games";

    VerticalLayout {
        spacing: 0px;

        DrawerHeader {
            back: "Menu";
            title: "Games";
            back-pressed => {
                root.back-pressed();
            }
        }

        // One row today, and a `Scroll` regardless — for `SettingsPage`'s reason: the row is
        // disabled and therefore `ROW_H + FIELD_REASON` tall, and §16.2's finding is that a layout
        // shorter than its children neither shrinks nor clips them, it draws them off the bottom.
        scroll := Scroll {
            vertical-stretch: 1;
            min-height: 0px;
            preferred-height: 0px;
            viewport-height: body.preferred-height;

            body := VerticalLayout {
                width: scroll.width;
                alignment: start;
                spacing: 0px;
                accessible-role: AccessibleRole.list;
                accessible-label: "Games";

                // Always first, and always enabled: a page whose only control is disabled when the
                // list is empty is a page you cannot get out of. This is the way in.
                Row {
                    index: 0;
                    count: root.titles.length + 1;
                    label: root.folder == "" ? "Choose where your titles are…" : "Titles are in";
                    value: root.folder == "" ? "" : root.folder;
                    // §6.2 gives paths, hashes, serials and addresses to `mono`.
                    sub-mono: true;
                    chevron: true;
                    activated => {
                        root.choose();
                    }
                    gained-focus => {
                        scroll.ensure-visible(self.absolute-position.y, self.height);
                    }
                }

                // §9.1's empty state for this page, and it is a sentence rather than a blank list:
                // an empty page and a page that has not been pointed anywhere look identical, and
                // only one of them is the operator's to fix.
                // **`if`, not `visible`.** §16.3's rule is that `visible: false` still reserves the
                // layout cell, and that is right where something would otherwise shuffle — but this
                // row is `ROW_H + FIELD_REASON` = 78 px of it, held open above the first title on
                // every shelf that has one. Read it off `_out/gui/games.png`: a blank band between
                // *Titles are in* and the first game. Nothing shuffles when it goes, because it is
                // drawn only in the state where there is nothing below it to move.
                if root.titles.length == 0: Row {
                    index: 1;
                    count: 2;
                    label: "No titles";
                    enabled: false;
                    machine-rule: false;
                    reason: root.folder == ""
                        ? "A title is a folder holding Executables/<name>.bin. Choose the one that holds yours, or the shelf they all sit in."
                        : root.folder-gone
                        ? "That folder is not there any more. Nothing was deleted by this program — it points at your files where they are, so a move or an unplugged drive reads like this. Choose it again where it is now."
                        : "Nothing in that folder holds Executables/<name>.bin, as itself or one level down.";
                }

                // ── The shelf: one cover per title, two across ─────────────────────────────
                //
                // **Everything drawn is out of the title's `Manifest.plist`** — issue #29. The
                // name is the top-level `Name`, the cover is what the 5G build's `LaunchingArtwork`
                // points at, and `runs` is whether the manifest lists a `PlatformID 1` build at
                // all. `main::title_row` reads all three; this page words none of it.
                //
                // **It was a list of names with a 24 px stamp on the trailing edge, and §22.5
                // retires that.** Read the old one off `_out/gui/games.png`: three titles in the
                // top 200 px of an 820 px page, each recognisable only by its name, with the
                // artwork the iPod itself draws reduced to a coloured chip. `LaunchingArtwork` is
                // the picture a person recognises a game by, so it is the primary and the name is
                // the fallback — which is what a `Tile` is and why §5 has a tenth primitive again.
                //
                // **A `Rectangle` with computed positions, not a `GridLayout`.** Slint's grid takes
                // static children; a shelf is a repeater over a model whose length is somebody's
                // folder. So the arithmetic is here, and every term in it is `Geometry`'s —
                // `no_geometry_literal_survives_in_the_markup` is what keeps it that way.
                //
                // **`Math.mod` and `Math.floor` on the index** is the whole of the layout: column
                // `i mod cols`, row `floor(i / cols)`. The viewport is sized from the same two
                // numbers below, so a shelf of 40 titles scrolls rather than drawing 18 rows past
                // the bottom edge — §16.2's finding, which is that a layout shorter than its
                // children neither shrinks nor clips them.
                if root.titles.length > 0: shelf := Rectangle {
                    // **One row's advance times the rows, plus the air above the first.** Every
                    // term is `Geometry`'s and the advance is the same constant the tiles are laid
                    // out on, so the height this reports and the position they are drawn at cannot
                    // disagree — which is the arithmetic a hand-positioned grid invites, and whose
                    // symptom is a shelf that stops one row short of its own last cover.
                    height: root.rows * Geometry.cover-row-adv + Geometry.cover-gap;

                    for t[i] in root.titles: Tile {
                        x: Geometry.page-margin
                            + Math.mod(i, root.cols) * (Geometry.cover-w + Geometry.cover-gap);
                        y: Geometry.cover-gap
                            + Math.floor(i / root.cols) * Geometry.cover-row-adv;
                        label: t.name;
                        cover: t.cover;
                        // A title that cannot run says why, in place, and is never hidden — §14.1.
                        // `PlatformID` answers it before anything is loaded, and the sentence is
                        // drawn where the picture would have been rather than under the tile.
                        enabled: t.runs;
                        reason: t.reason;
                        // §22.5's double-press, and the arm is the PAGE's so only one can hold it.
                        armed: root.armed == i;
                        activated => {
                            if (root.armed == i) {
                                root.armed = -1;
                                root.play(i);
                            } else {
                                root.armed = i;
                            }
                        }
                        gained-focus => {
                            scroll.ensure-visible(self.absolute-position.y, self.height);
                        }
                    }
                }
            }
        }
    }
}
