// The shared vocabulary — docs/GUI.md §5, §6.5, §6.7, §16.3, §16.5, §16.11.
//
// Five things live here and nothing else: the **material**, the **icon** set, the **Pressable**
// construction §16.5 specifies once so it is not reinvented per control, the **Row** every drawer
// page is made of, and **Scroll** — the ninth primitive, and the only element in the whole program
// that declares a `Flickable`.
//
// **The Flickable is here so its whole cost is paid in one place and audited there.**
// `every_flickable_declares_itself_not_interactive` in `tests/markup_discipline.rs` asserts both
// halves: that the one Flickable is not interactive, and that there is exactly one.

import { Ink, Metric, Motion } from "tokens.slint";
// Generated by build.rs from src/geometry.rs (docs/GUI.md §16.9). Every size on this page comes
// from there, so a test cannot hand-copy one and stay green.
import { Geometry } from "@geometry";

// ─── The boundary (§11.1, §11.2, §11.4, §11.6) ──────────────────────────────────────────────────
//
// **Every row a drawer page draws, flattened.** Each of these is built in `main.rs` out of
// `composer.rs` / `parts.rs` / `devices.rs`, which are built out of the model in `eapp-loader` —
// so no page below states a policy or words a sentence, and the window and the model cannot
// disagree about what a recipe does.
//
// **They live here rather than in `ui/window.slint`**, which is where the contract put them, for
// the reason `DrawerHeader` gives four hundred lines down: `window.slint` imports `drawer.slint`,
// which imports every page, so a page importing `window.slint` back is a cycle. This file is the
// leaf every page already imports and these are the shapes its primitives render — a `PickRow` is
// what a `Row` draws, a `FieldRow` is what a `Field` draws, a `TickRow` is what a `Check` draws.
//
// **`field` / `group` / `kind` / `action` cross as `int`.** `rail-next(int, int)` set the precedent
// and the reason is the same: the markup never needs to name one, and a Slint enum would put the
// vocabulary in the markup. Rust's side is an exhaustive `from_i32`, so an unknown value is a
// refusal rather than a wrong branch.

// §9.4's disabled construction, as data: the two kinds worded differently, and §11.3's second press
// with the sentence that has to be read before the first. Declared first — `RefusalRow`, `GroupRow`
// and the pages all embed one, and `process_struct` inserts into the local registry in document
// order (`object_tree.rs:205-250`).
export struct FixRow {
    label: string,
    enabled: bool,
    reason: string,
    escape-hatch: string,
    machine-rule: bool,
    presses: int,
    consequence: string,
}

// §11.2's levels ① and ②: a picker, which is a `Row` with a chevron whose options live in the
// `Expand` under it. **A locked picker stays a picker** (§11.1) — `locked` greys the row and states
// why, and the `Expand` never opens; it does not collapse to a line of text, because that is what
// makes the page jump when you switch between a dump and a synthesised ROM.
export struct PickRow {
    field: int,
    label: string,
    value: string,
    enabled: bool,
    locked: bool,
    note: string,
    reason: string,
    escape-hatch: string,
    machine-rule: bool,
    chevron: bool,
    open: bool,
    // `composer::Lock::presses` — **two while N devices are made of this iPod**, because opening
    // that picker is agreeing to change all of them. `note` is the lock's own sentence and is what
    // the `Row` draws as its `consequence`, so the count and the sentence come from one `Lock`.
    presses: int,
}

// One option inside the one open picker. §11.3's *every box ticks*: a refused value stays, in place,
// at its own height, in `fg-disabled`, and says why — it is never absent.
export struct OptionRow {
    id: int,
    label: string,
    sub: string,
    enabled: bool,
    chosen: bool,
    reason: string,
    escape-hatch: string,
    machine-rule: bool,
    // §11.3's press count, on the option rather than on the row that opens it. Exactly one option
    // in this program is worth two: `Make one`, which mints over the identity on screen and cannot
    // be undone — `composer::Composer::make_one_row` is where both of these come from.
    presses: int,
    consequence: string,
}

// §11.2's identity rows and §11.2's name. **`value` is what is drawn and is already masked;
// `raw` is `""` while masked** — so while a field is masked the markup holds no identifier at all.
// That is `composer::Secret`'s boundary, expressed in the type rather than in a rule somebody has
// to remember.
export struct FieldRow {
    field: int,
    label: string,
    value: string,
    raw: string,
    masked: bool,
    locked: bool,
    mono: bool,
    note: string,
    reason: string,
    action: string,
}

// §11.3's systems list. `os` is the ordinal in `Os::ALL`, so all three are offered and the two that
// are not in `OFFERED` are drawn disabled with their project-state reason.
export struct TickRow {
    os: int,
    label: string,
    on: bool,
    enabled: bool,
    reason: string,
    escape-hatch: string,
}

// §11.2's plan — `Recipe::steps()`, one line per step. **One list rendered twice**: here as *this is
// what will be downloaded*, and on the Work page as a ticking checklist while it runs.
export struct PlanRow {
    verb: string,
    what: string,
    sub: string,
}

// §11.3 item 2: the reason is a paragraph under the value that caused it, reserved via an `Expand`,
// verbatim from `Verdict::No.why`. At most one `Fix` with it.
export struct RefusalRow {
    why: string,
    has-fix: bool,
    fix: FixRow,
    open: bool,
}

// §11.4's six groups, fixed order, always all six present even when empty. `a` and `b` are the
// group's own verbs — `Add a dump…` / `Synthesise…`, `Fetch…` / `Provide…`, `Build…`, `Discard`.
export struct GroupRow {
    group: int,
    heading: string,
    count: int,
    verb: string,
    empty: string,
    a: FixRow,
    b: FixRow,
    has-a: bool,
    has-b: bool,
    // **Which `Action` each verb IS**, and the contract's own list did not carry it. `parts-group-
    // action(Group, Action)` cannot be fired without it: `Group::actions()` is per group —
    // `[AddDump, Synthesise]` for iPods, `[Fetch, Provide]` for firmware, `[Build, Provide]` for
    // disks — so a markup passing a slot index would have fired `Add a dump…` for `Fetch…`. The
    // ordinal travels with the row that draws it.
    a-action: int,
    b-action: int,
}

// One part. `fact` is `Provenance::line()` and nothing in the window may construct the word
// *verified*; `used-by` is the reference-not-copy property made visible; `locked-by` is §11.4's one
// machine rule — *`My 5.5G` is running.*
// `open` is **deliberately absent.** It was declared here and read by nothing: `PartRowView.open`
// is bound from `root.detail-of == r.id` by the page, which is the one cursor, and `parts::PartView`
// has no such field to fill it from. A second spelling of *which row is open* is §20 item 4's
// `parked` — computed, pushed, and bound to nothing — and this is where it would have started.
export struct PartRow {
    id: int,
    group: int,
    kind: int,
    name: string,
    fact: string,
    used-by: string,
    expandable: bool,
    selected: bool,
    removable: bool,
    remove-consequence: string,
    locked-by: string,
}

// One device, flattened for the markup. **Every string on it is the model's**, built in `main.rs`
// out of `settings.rs` — no markup file words one, which is what stops the window and the model
// disagreeing about what a device is.
//
// **It moved here from `ui/window.slint` and gained no fields.** §7.2's Devices page needs it, and
// a page importing `window.slint` back is a cycle. The contract's own list adds `parts`, `parked`
// and `remove-consequence`; none of the three is taken, and the reason is in the document rather
// than in a preference. `parked` was **deleted** by §20 item 4 — *"it was computed and bound to
// nothing in any markup file, which is item 15's defect in a new place"* — and what the shelf and
// the page actually want is §7.5's *state, and time since*, which `state` carries (`off`, or
// `off, parked 4 min ago`). `parts` is `summary` under a second name. And a `Remove` consequence is
// a line inside the row's own `Expand`, where `DetailRow.consequence` already carries it.
//
// `ResourceRow` went with the Resources tab. Its one test —
// `no_row_claims_a_verification_the_model_did_not_record` — was re-expressed onto
// `Provenance::line()` rather than dropped (§16.10), and is still in `main.rs`.
// §6.4: **three colours and one shape, not four colours.** A closed set, declared as one, so a
// fourth cannot arrive by accident — and the shape (a *broken* ring) is the fourth state, because
// there is no fourth colour on `bg-sunken` that clears 3 : 1 and does not already mean something
// else.
//
// It lives in this leaf rather than in `bench.slint`, which draws it, because since Phase 7 the
// ring is **decided in Rust** — `machine::cradle` returns the colour and the continuity together —
// so it is a field of `DeviceRow` below, and `bench.slint` imports this file.
export enum CradleRing { accent, dim, danger }

export struct DeviceRow {
    name: string,
    summary: string,
    state: string,
    write-target: string,
    write-target-is-warning: bool,
    chassis: color,
    dark-chassis: bool,
    // §7.3: can the cradle hold this one? False where a part of it has left the library, which is
    // the refusal §20 item 1 already produces and §20 item 12 requires somewhere to show.
    startable: bool,
    // §7.3's label: what pressing will cost, or why it cannot be pressed. The model's sentence,
    // verbatim.
    cradle-label: string,
    // **The same sentence, for a surface with no centre button on it.** §9.5's pane replaces the
    // well and draws the press as a Row, so `press the centre button` would be a caption pointing
    // at a control that is not drawn — which is the exact defect §9.5 exists to delete. `main::
    // Press` writes one tail and two prefixes; this is the second one, per device, so it follows
    // `selected` the way `cradle-label` does rather than being pushed once for a bench that has
    // moved on.
    press-label: string,
    // §7.3's ring, decided by `machine::cradle` alongside the label above — one call, so the colour
    // and the sentence cannot describe two different states of one iPod.
    //
    // **`danger` is reachable now, and that is the whole reason this stopped being a markup
    // expression.** `ui/window.slint` computed the ring from `startable`, which has two values, and
    // §7.3's table has three: `accent` for a device that can be pressed, `fg-dim` for one that
    // cannot, and `danger` for **a machine that stopped** — a state no build before Phase 7 could
    // be in. Spending `danger` on *a file moved* would leave nothing to say *a machine died* with.
    cradle-ring: CradleRing,
    // Gaps in the outline (§7.3). **Not `!startable`**, which is what the markup computed: §7.3
    // gives a broken ring to its three `cannot start` rows and to nothing else, so a composed
    // device this build cannot make a drive for is *unfinished*, not broken. `machine::Blocked::
    // breaks_the_ring` is the one place that decides.
    cradle-broken: bool,
}

// One line inside an expanded row — `parts::Detail` flattened. A `Fact`, a `Paragraph`, a
// `MachineRule`, a `Mono` or an `Act`; `has-action` is which.
export struct DetailRow {
    label: string,
    value: string,
    mono: bool,
    machine-rule: bool,
    action: int,
    has-action: bool,
    act-label: string,
    enabled: bool,
    reason: string,
    escape-hatch: string,
    presses: int,
    consequence: string,
    // **The act's colour, decided by the act.** `parts.slint` drew every one of these in
    // `Ink.accent` and `devices.slint` drew every one in `Ink.danger` — one struct, one flattener,
    // two answers — so `Edit…` was red on the page that has it. `parts::RowAction::destructive` is
    // the producer and `Remove` is the only true one.
    destructive: bool,
}

// ─── The material (§6.5) ────────────────────────────────────────────────────────────────────────
//
// A 1 px darker top rule, an immediate bright band, a gentle fall — sampled down a vertical strip
// of RetailOS's own selection. Used for exactly three things: the selected row in a drawer list,
// the one primary row on a drawer page, and the one primary row on the too-short bench. Everywhere
// else is flat. A window where everything is glossy is a pastiche.
//
// It does NOT go on the centre button: a glossy blue disc is UI state painted on the object, and a
// screenshot of it is no longer a picture of an iPod.
export component Material inherits Rectangle {
    background: @linear-gradient(180deg, Ink.material-top 0%, Ink.material-bottom 100%);
    Rectangle {
        y: 0;
        height: 1px;
        background: Ink.material-rule;
    }
}

// ─── Icons (§6.7) ───────────────────────────────────────────────────────────────────────────────
//
// **No icon is a font glyph.** Every one is a vector `Path` from a closed set, sized on the space
// scale. The previous window shipped twelve missing glyphs to the operator as empty squares, and
// nothing in `.slint` can ask whether a glyph exists (§16.6) — so the set is drawn, and the
// drawing is the coverage guarantee.
//
// `flip` selects a pre-mirrored `commands` string rather than transforming the path, because
// **`Path` has no transform and `commands` cannot be read in an expression** (§16.6). The mirror is
// `x' = 24 - x` on a 24-unit viewbox, done by hand.
//
// Every kind is a **filled closed shape** — `Path` has no dash array, which is also why §7.3's
// refused cradle is a broken ring rather than a dashed one. `evenodd` is what puts the two holes in
// `warning`; every other kind here is a single non-self-intersecting outline, for which `evenodd`
// and `nonzero` are the same fill.
//
// Never `visible: false` on this component's own root — §16.3, and the compiler only warns
// (`passes/visible.rs:28-33`). Set it at the use site, as `Row` and `Scroll` below do.
export component Icon inherits Path {
    // This phase: "back" | "close" | "expand" | "collapse" | "check" | "warning". The full set is
    // sixteen (§6.7); the other ten arrive with their use sites.
    in property <string> kind;
    in property <color> ink;
    // Horizontally mirrored, for the trailing chevron of a Row.
    in property <bool> flip: false;

    fill: ink;
    fill-rule: FillRule.evenodd;
    viewbox-width: 24;
    viewbox-height: 24;
    // The ternary chain is the `WheelMark` pattern from `ipod.slint:50-61`, which is the only shape
    // Slint offers: `commands` is a binding, so there is no table to index.
    commands: root.kind == "back"
        ? (root.flip
            ? "M 9 3.6 L 7 5.6 L 13.4 12 L 7 18.4 L 9 20.4 L 17.4 12 Z"
            : "M 15 3.6 L 17 5.6 L 10.6 12 L 17 18.4 L 15 20.4 L 6.6 12 Z")
        : root.kind == "close"
        ? "M 5.6 7 L 7 5.6 L 12 10.6 L 17 5.6 L 18.4 7 L 13.4 12 L 18.4 17 L 17 18.4 L 12 13.4 L 7 18.4 L 5.6 17 L 10.6 12 Z"
        : root.kind == "expand"
        ? "M 3.6 9 L 5.6 7 L 12 13.4 L 18.4 7 L 20.4 9 L 12 17.4 Z"
        : root.kind == "collapse"
        ? "M 3.6 15 L 5.6 17 L 12 10.6 L 18.4 17 L 20.4 15 L 12 6.6 Z"
        : root.kind == "check"
        ? "M 9.4 18.6 L 3.4 12.6 L 5.4 10.6 L 9.4 14.6 L 18.6 5.4 L 20.6 7.4 Z"
        : "M 12 3 L 22.5 21 L 1.5 21 Z M 10.9 9 L 13.1 9 L 13.1 15 L 10.9 15 Z M 10.9 16.8 L 13.1 16.8 L 13.1 19 L 10.9 19 Z";
}

// ─── ReasonSlot (§5, §9.4, §16.5) ───────────────────────────────────────────────────────────────
//
// §5's 34 px two-line reason slot, lifted out of `Pressable` **unchanged** so `Field` can have one
// without a second copy of it. It **elides** rather than growing its owner: a 250-character machine
// rule does not fit in 34 px at any width, so the full text lives in `accessible-description` and,
// for a failure, in the Rail entry's own `happened` paragraph — and for §11.3's refusal, in the
// `Expand` one level up, which is not a reason slot at all.
//
// This is the only extraction in this phase, and it exists because `Field` and `Pressable` must
// reserve the *same* slot: §11.1's *existing and new look identical* is a height claim before it is
// anything else, and two slots of 34 px that were written twice are two slots that drift.
//
// **The height was the same and the WIDTH was not, and that is the defect this component now
// measures.** `Pressable` handed this its own `pad`; `Field` handed it nothing and took the `0px`
// default — so on `ui/composer.slint`, where a `Field` and a picker `Row` sit in one column,
// `Read from the dump; a device's identity is the ROM's, not ours.` drew **whole** under `Serial`
// and elided to *…not …* under `Model`, four rows apart, from one string. Read it off
// `_out/gui/composer-ipod-dumped.png`; nothing in the suite could see it, because §9.4's sweep
// measured every sentence against one number and never asked which slot drew it.
//
// The difference is real and it is kept: `pad` exists so a reason lines up under the label it is
// about, and a `Field`'s label is at its owner's margin while a `Row`'s is one `pad` further in.
// What changes is that both owners now **state** it — `Field` has the same knob and passes it — and
// that [`measure`] reports what the slot actually got, so §9.4's budget is checked against the slot
// the sentence lands in rather than against a number somebody typed.
export component ReasonSlot inherits Rectangle {
    // Reserved whenever the owner has something to tell you. Never derived here — the owner knows.
    in property <bool> tells;
    in property <string> text;
    in property <string> escape-hatch;
    // §9.4: a project state names its escape hatch as a command in `mono`; a machine rule does not.
    // The owner computes it (`!enabled && !machine-rule`) rather than this slot re-deciding it.
    in property <bool> show-hatch;
    // §11.3: the first of two presses has been taken, so the sentence is about what the second does.
    in property <bool> armed;
    // The owner's own horizontal padding, so a reason lines up under the label it is about.
    in property <length> pad: 0px;

    // **What the sentence actually got**, after the owner's width and this pad — the number §9.4's
    // budget has to be checked against. Read out, never in; `MainWindow`'s three slot probes expose
    // it for `the_two_reason_slots_differ_by_exactly_the_pad_that_indents_one_of_them`, which is
    // what makes the paragraph above a measurement rather than a claim.
    //
    // **Not `measure`**, which is what it was called for an hour. `RailRow.measure` is a *string* —
    // `4.1 MB of 6.5 MB` — and `geometry::declared_lengths` collects every `property <length>` name
    // in the markup and then treats any binding to that name as geometry, so one `<length>` called
    // `measure` made `no_geometry_literal_survives_in_the_markup` fail on `ui/preview.slint`'s
    // progress fixture. A name is shared across every `.slint` file whether or not the components
    // are; the scanner is what said so.
    out property <length> reason-measure: line.width;

    height: root.tells ? Geometry.field-reason : 0px;
    clip: true;
    visible: root.tells;

    VerticalLayout {
        alignment: start;
        spacing: 0px;
        padding-left: root.pad;
        padding-right: root.pad;

        line := Text {
            height: Geometry.line-label;
            text: root.text;
            font-size: Metric.label-size;
            font-weight: Metric.weight-label;
            color: root.armed ? Ink.danger : Ink.fg-dim;
            overflow: elide;
            vertical-alignment: center;
        }

        // §9.4: a project state always names the escape hatch, as a command in `mono`.
        Text {
            height: Geometry.line-mono;
            text: root.escape-hatch;
            font-family: Metric.mono-family;
            font-size: Metric.mono-size;
            color: Ink.fg-dim;
            overflow: elide;
            vertical-alignment: center;
            visible: root.show-hatch;
        }
    }
}

// ─── The one pressable construction (§16.5, §9.4, §11.3) ────────────────────────────────────────
//
// **Two traps, both verified in the toolkit source, and both fatal to the obvious construction:**
//
//   - `TouchArea { enabled: false }` forcibly sets `has_hover = false` and returns
//     `ForwardAndIgnore` (`i-slint-core-1.17.1/items/input_items.rs:80-91`), so a disabled control
//     cannot show its reason on hover.
//   - `FocusScope { enabled: false }` refuses focus **even programmatically**
//     (`builtins.slint:903`), so a disabled control cannot show its reason on focus either.
//
// So: an always-enabled outer `TouchArea` + `FocusScope` carrying hover, the focus ring and the
// reason, wrapping an action gated by a plain boolean. **Never `enabled:` on either of them.**
// That is the whole component, and `every_disabled_control_states_its_reason_under_keyboard_focus_alone`
// is the mechanical form of it.
//
// **`inert` is a different thing from `enabled: false` and must not be confused with it.** Disabled
// means *this is a control, and here is why you cannot use it* — it stays in the tab order (§9.4,
// §14.1). Inert means *this line is not a control at all*: §9.1's empty-group row, §5's group
// heading. Inert is expressed with `focus-on-tab-navigation` and `focus-on-click`, which take the
// line out of the tab order **without** disabling the FocusScope — so the ban above holds.
export component Pressable inherits Rectangle {
    // Required. An empty label is a defect, not a state.
    in property <string> label;
    in property <bool> enabled: true;
    // §9.4 — non-empty whenever `!enabled`.
    in property <string> reason;
    // §9.4's two kinds. A machine rule says *this cannot work, ever*, and carries a `Fix`; a
    // project state says *this is not finished, by us*, and carries a command in `mono`.
    in property <bool> machine-rule: true;
    in property <string> escape-hatch;
    // Wears the material. ONE per page (§6.5).
    in property <bool> primary: false;
    // Also wears the material — §6.5 use 1, the selected row.
    in property <bool> selected: false;
    // 0.6 for a `Fix` — offered rather than urged (§6.5).
    in property <float> material-opacity: 1.0;
    // §11.3: 2 where a press detaches a resource. `consequence` is what the second press will do,
    // and it is shown BEFORE the first.
    in property <int> presses: 1;
    in property <string> consequence;
    // Not a control: no tab stop, no click focus, no callback. See the note above.
    in property <bool> inert: false;
    // Horizontal padding inside the control. §6.3: 12 inside a control, 24 at a drawer page margin.
    in property <length> pad: 0px;
    // **A fact about the row, on a second line inside the same hit region and the same accessible
    // node** — §11.4's `synthesised, seed 4f2a, used by 2` under `Black 5.5G`. The default `""`
    // costs zero height, so every existing use site is byte-identical to what it was.
    in property <string> sub;
    // §6.2: a path, a hash, a serial or an address is `mono`; prose is not. One boolean rather than
    // a second `sub` property, so a row cannot carry both and draw neither.
    in property <bool> sub-mono: false;
    // §5's ring, drawn for a control whose focus lives on a child this construction does not own —
    // `Field`'s `TextInput`. Without it a `Field` would have to invent a second ring, and two ring
    // constructions is how they come to be drawn in two places.
    in property <bool> focus-inside: false;
    // **The announcement, split from the gate** — §7.4's rule, which had no way to reach a
    // `Pressable` until §9.5's pane needed it. `bench.slint`'s cradle calls `pressed-centre` in
    // every state, because Rust is the only thing that can say *which part is gone* and a press
    // that teaches nothing is worse than a press that is refused; what it varies is
    // `accessible-enabled`, so an assistive technology is told the device cannot start while the
    // press still files the sentence saying why. §9.5's Row is that same press on a surface with no
    // cradle, so it needs the same split. Defaults to `enabled`, which is what every other use site
    // in this markup means by it.
    in property <bool> announce-enabled: root.enabled;

    out property <bool> armed: false;
    out property <bool> has-focus: focus.has-focus;
    out property <bool> has-hover: touch.has-hover;
    // §9.4's budget, as this control actually drew it — `width` less two `pad`. Every use site in
    // this markup that sets `pad: Geometry.page-margin` inside a page that already pads by one gets
    // 324 here where a `Field` beside it gets 372; that difference is the reason this is measured
    // and not assumed.
    out property <length> reason-measure: slot.reason-measure;

    callback activated();
    // Fired when the keyboard put focus here, so a page inside a `Scroll` can bring it into view.
    // §16.11: `Tab` / `⇧Tab` is the only keyboard scroll route this program has, because `↑` / `↓`
    // belong to the machine's wheel, always (§16.8).
    callback gained-focus();

    public function disarm() {
        root.armed = false;
    }

    // §9.5: the pane's primary Row is the only start affordance on a 1280 x 800 display, so the
    // window has to be able to hand it focus the way it hands the cradle focus. `focus` is an
    // internal element and `forward-focus` cannot reach inside a component, which is the same
    // reason `Bench::focus-cradle` exists one level up.
    public function take-focus() {
        focus.focus();
    }

    // **The slot is reserved whenever this control has something to tell you**, and every term is
    // static per control — so arming changes the wording and the colour and moves nothing. A
    // control that grows when you press it is content moving under the cursor (principle 2).
    //
    // **`consequence != ""` is the third term and it was missing.** §11.3's `BuildFromIpsw` is the
    // two-press case, but a one-press control may carry a consequence too — §11.4's `Remove` names
    // its dependents before it acts — and without this term that sentence had nowhere to be drawn.
    //
    // **`inert` withdraws the first term**, and that is not a special case: an inert line is not a
    // control at all (§9.1's empty-group line, §5's group heading, §11.4's reserved plugged-in row),
    // so it has no reason to state and reserving 34 px under it is 34 px of nothing. A disabled
    // CONTROL still states why and still stays in the tab order — that is §9.4, and it is untouched.
    property <bool> tells: (!root.enabled && !root.inert)
        || root.presses == 2
        || root.consequence != "";

    // 44 plain · 60 with a fact line · 78 disabled, two-press or carrying a consequence · 94 both.
    // Those four numbers are the whole of every fit test's arithmetic in this phase.
    height: Geometry.row-h
        + (root.sub == "" ? 0px : Geometry.line-label)
        + (root.tells ? Geometry.field-reason : 0px);

    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-description: root.enabled ? root.consequence : root.reason;
    accessible-enabled: root.announce-enabled && !root.inert;

    VerticalLayout {
        spacing: 0px;

        // **The material spans the row cell AND the fact line**, so a selected row reads as one
        // object rather than as a blue band with a caption hanging off the bottom of it.
        Rectangle {
            height: Geometry.row-h + (root.sub == "" ? 0px : Geometry.line-label);

            Material {
                width: 100%;
                height: 100%;
                visible: root.primary || root.selected;
                opacity: root.material-opacity * (touch.pressed ? 0.86 : 1.0);
                animate opacity {
                    duration: Motion.tight;
                    easing: ease-out-quad;
                }
            }

            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: Geometry.row-h;

                    // No `alignment`: setting one makes `horizontal-stretch` inert
                    // (`i-slint-core-1.17.1/layout.rs:1274-1279`), which is the defect the chrome
                    // bar's own comment records.
                    HorizontalLayout {
                        padding-left: root.pad;
                        padding-right: root.pad;
                        @children
                    }
                }

                // §11.4's fact line. `visible`, never `if` — §16.3: the cell is allocated at
                // lowering step 156 and `visible` runs at 180, so a row that gains a fact does not
                // shuffle the rows below it. Its height is zero when there is nothing to say, which
                // is what makes that free.
                Rectangle {
                    height: root.sub == "" ? 0px : Geometry.line-label;
                    clip: true;
                    visible: root.sub != "";

                    HorizontalLayout {
                        padding-left: root.pad;
                        padding-right: root.pad;

                        Text {
                            text: root.sub;
                            font-family: root.sub-mono ? Metric.mono-family : "";
                            font-size: root.sub-mono ? Metric.mono-size : Metric.label-size;
                            font-weight: Metric.weight-label;
                            color: !root.enabled
                                ? Ink.fg-disabled
                                : (root.selected ? #ffffff : Ink.fg-dim);
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        slot := ReasonSlot {
            tells: root.tells;
            text: root.enabled ? root.consequence : root.reason;
            escape-hatch: root.escape-hatch;
            show-hatch: !root.enabled && !root.machine-rule;
            armed: root.armed;
            pad: root.pad;
        }
    }

    // §8.1 item 9: the focus ring is instant, always. A focus ring that animates is a focus ring
    // you lose.
    Rectangle {
        width: 100%;
        height: 100%;
        border-width: Geometry.focus-ring-w;
        border-color: Ink.accent;
        visible: focus.has-focus || root.focus-inside;
    }

    // §11.3: the first of two presses has been taken. Same weight as the focus ring, `danger`
    // rather than `accent`, and it too is instant.
    Rectangle {
        width: 100%;
        height: 100%;
        border-width: Geometry.focus-ring-w;
        border-color: Ink.danger;
        visible: root.armed;
    }

    focus := FocusScope {
        // NOT `enabled:` — see the note at the top of this component. These two take an inert LINE
        // out of the tab order; a disabled CONTROL stays in it and states its reason.
        focus-on-tab-navigation: !root.inert;
        focus-on-click: !root.inert;

        focus-gained(reason) => {
            root.gained-focus();
        }

        // `accessible-action-default` is NOT a keyboard route: nothing in `i-slint-core` ever
        // invokes `AccessibilityAction::Default` — only the accesskit adapter does, from a screen
        // reader. Enter and Space are handled here, by hand.
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                touch.clicked();
                return accept;
            }
            // Everything else bubbles — §16.8. `Esc`, the arrows and `⌘\` belong to the window.
            return reject;
        }
    }

    touch := TouchArea {
        // The gate is a plain boolean inside the handler, never `enabled:` on this element.
        clicked => {
            if (root.inert || !root.enabled) {
                return;
            }
            if (root.presses == 2) {
                if (!root.armed) {
                    root.armed = true;
                    return;
                }
                root.armed = false;
            }
            root.activated();
        }
    }
}

// ─── Row (§5) ───────────────────────────────────────────────────────────────────────────────────
//
// One thing, on a line, 44 px: label leading, value at 232 px, chevron trailing. Every drawer page
// is made of these, so the value column has one x on every page.
//
// `inherits Pressable` rather than wrapping one: the children written below land in the
// `@children` slot inside Pressable's row cell (`passes/inlining.rs:120-165`), so there is one
// element carrying one accessible role rather than a list item wrapped around a button.
//
// **The chevron's cell is always allocated** — `visible`, never `if` — so a row with a chevron and
// a row without one have the same value column, and a page whose rows differ does not have a
// ragged value edge (§16.3).
export component Row inherits Pressable {
    in property <string> value;
    // This row goes one level deeper.
    in property <bool> chevron: false;
    // A group heading: `title`, no chevron, and not a control at all.
    in property <bool> heading: false;
    // The value renders in `warn`.
    in property <bool> warn: false;
    in property <int> index;
    in property <int> count;

    inert: root.heading;
    pad: Geometry.page-margin;

    accessible-role: AccessibleRole.list-item;
    accessible-item-index: root.index;
    accessible-item-count: root.count;

    Text {
        width: Geometry.row-value-x;
        text: root.label;
        font-size: root.heading ? Metric.title-size : Metric.body-size;
        font-weight: root.heading ? Metric.weight-title : Metric.weight-body;
        color: !root.enabled
            ? Ink.fg-disabled
            : (root.selected ? #ffffff : Ink.fg);
        overflow: elide;
        vertical-alignment: center;
    }

    Rectangle {
        width: Geometry.row-value-w;

        Text {
            x: 0;
            // The chevron's gutter, reserved on every row whether or not one is drawn.
            width: parent.width - Metric.s4;
            height: 100%;
            text: root.value;
            font-size: Metric.body-size;
            font-weight: Metric.weight-body;
            color: root.warn
                ? Ink.warn
                : (root.enabled ? Ink.fg-dim : Ink.fg-disabled);
            horizontal-alignment: right;
            overflow: elide;
            vertical-alignment: center;
        }

        Icon {
            kind: "back";
            flip: true;
            ink: root.enabled ? Ink.fg-dim : Ink.fg-disabled;
            x: parent.width - Metric.s3;
            y: (parent.height - self.height) / 2;
            width: Metric.s3;
            height: Metric.s3;
            visible: root.chevron;
        }
    }
}

// ─── Field (§5, §11.1, §11.2) ───────────────────────────────────────────────────────────────────
//
// §5's fifth primitive: a labelled input, which may be **locked** and states why.
//
// **Three cells, not a Row's two, and the reason is measured rather than preferred.** A 16-hex-digit
// GUID at `Metric.mono-size` 13 is about 129 px; a `Row`'s drawable value width is `ROW_VALUE_W`
// 140 less a 16 px chevron gutter = 124. The identity values elide in a `Row` and do not in a
// `Field`, which is why this is its own primitive and not a `Row` with an editable value.
//
// **The reason slot is ALWAYS reserved**, whether it is filled or not — `reason` when there is one,
// `note` otherwise. That reservation is what sets this control's height, and it is what makes
// §11.1's *existing and new look identical* mechanical: a locked retail row and an editable
// synthetic row are `ROW_H + FIELD_REASON` either way, so the surface does not jump when you switch
// between them.
//
// **Masked means read-only, and `Show` reveals and enables in one act** (§11.2). So the drawn text
// and the editable text are never different things, and a masked value cannot be
// selected-and-copied either: the hole closes by construction as well as by rule. The cost is
// named — you cannot type a serial without pressing `Show` first — because the alternative is
// either drawing what you type as bullets, which is a password field and this is not a secret, or
// drawing the value while claiming it is masked.
//
// **`enabled: false` appears on no `TouchArea` and no `FocusScope` here** (§16.5). The lock is
// `read-only` on the `TextInput`; the row stays in the tab order and states its reason.
export component Field inherits Rectangle {
    in property <string> label;
    // **What is drawn.** Already masked when `masked` — this component does no masking of its own,
    // because `identity::mask_serial` is the one mask in this workspace and a second one in markup
    // is a second boundary to get wrong.
    in property <string> value;
    // What may be edited. `""` while masked, and never both.
    in property <string> raw;
    in property <bool> locked: false;
    in property <bool> masked: false;
    in property <bool> mono: false;
    in property <string> note;
    in property <string> reason;
    // `Show` | `Hide` | `""`. Four characters either way, so the cell does not change size when the
    // mask comes off — §11.2's *pressing `Show` changes no width and moves nothing*.
    in property <string> action;
    // **The same knob `Pressable` has, and it is here because its absence was invisible.** This
    // control's row has no padding of its own, so the honest value is `0px` — a `Field`'s label
    // starts at its owner's margin and its reason lines up under it. But `0px` was arrived at by
    // omission: `Pressable` passed its own `pad` down to `ReasonSlot` and this passed nothing, so
    // the two primitives disagreed about a width by `2 × pad` with neither of them saying so. A
    // default that is stated can be argued with; one that is inherited from a component two files
    // away cannot. See `ReasonSlot`'s header for the sentence that drew two ways because of it.
    in property <length> pad: 0px;

    callback edited(string);
    callback act();
    callback gained-focus();

    // §9.4's budget as this control actually drew it — the twin of `Pressable.reason-measure`, and
    // the pair is the whole of `the_two_reason_slots_differ_by_exactly_the_pad_that_indents_one_of_
    // them`.
    out property <length> reason-measure: slot.reason-measure;

    height: Geometry.row-h + Geometry.field-reason;

    // The one string the `TextInput` may hold. Masked → the mask, and it is `read-only`, so the
    // mask is what a selection would copy too.
    property <string> editable-text: root.masked ? root.value : root.raw;
    // Slint's `TextInput` **writes its own `text` property** when a person types, which dissolves
    // any binding on it. So the binding is restored here rather than relied on: without this a
    // `Show` after one keystroke would reveal the value everywhere except in the control it was
    // typed into. It cannot loop — this writes `input.text`, and nothing feeds `input.text` back.
    changed editable-text => {
        input.text = root.editable-text;
    }

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: Geometry.row-h;

            HorizontalLayout {
                spacing: 0px;
                padding-left: root.pad;
                padding-right: root.pad;

                Text {
                    width: Geometry.field-label-w;
                    text: root.label;
                    font-size: Metric.body-size;
                    font-weight: Metric.weight-body;
                    color: root.locked ? Ink.fg-disabled : Ink.fg;
                    overflow: elide;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: Geometry.field-value-w;

                    input := TextInput {
                        width: 100%;
                        height: 100%;
                        text: root.editable-text;
                        font-family: root.mono ? Metric.mono-family : "";
                        font-size: root.mono ? Metric.mono-size : Metric.body-size;
                        font-weight: Metric.weight-body;
                        color: root.locked ? Ink.fg-disabled : Ink.fg;
                        selection-background-color: Ink.accent;
                        selection-foreground-color: #ffffff;
                        single-line: true;
                        wrap: no-wrap;
                        vertical-alignment: center;
                        // **Never `enabled: false`** — that is a `FocusScope` refusing focus even
                        // programmatically (§16.5). `read-only` keeps the row in the tab order and
                        // keeps its reason reachable by keyboard alone.
                        read-only: root.locked || root.masked;

                        accessible-role: AccessibleRole.text-input;
                        accessible-label: root.label;
                        // §7: the accessible tree carries **what is drawn** — the mask — so a
                        // screen reader never captions somebody's identifier.
                        accessible-value: root.value;
                        accessible-read-only: root.locked;
                        accessible-description: root.reason != "" ? root.reason : root.note;

                        edited => {
                            root.edited(self.text);
                        }
                        // §16.11: `Tab` is the only keyboard route into a `Scroll`, so every tab
                        // stop reports where it landed.
                        changed has-focus => {
                            if (self.has-focus) {
                                root.gained-focus();
                            }
                        }
                    }
                }

                // **The cell is allocated whether or not there is an action** (§16.3), so a field
                // with a `Show` and a field without one have the same value column.
                act := Pressable {
                    width: Geometry.field-action-w;
                    label: root.action;
                    inert: root.action == "";
                    // §5's ring, drawn by the one construction that draws every other ring in this
                    // program rather than by a second one invented here. `Field` is the reason
                    // `focus-inside` exists: the focus lives on the `TextInput`, which is not this
                    // `Pressable`'s own `FocusScope`.
                    focus-inside: input.has-focus;
                    activated => {
                        root.act();
                    }
                    gained-focus => {
                        root.gained-focus();
                    }

                    Text {
                        text: root.action;
                        font-size: Metric.body-size;
                        font-weight: Metric.weight-strong;
                        color: Ink.accent;
                        horizontal-alignment: right;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Always reserved. `tells: true` is not a shortcut — it IS §11.1's height claim.
        slot := ReasonSlot {
            tells: true;
            text: root.reason != "" ? root.reason : root.note;
            show-hatch: false;
            armed: false;
            pad: root.pad;
        }
    }
}

// ─── Expand (§5, §8.1, §11.3, §11.4, §16.11) ────────────────────────────────────────────────────
//
// In-place detail for a Row, pushing the rows below it down. `gentle`, and inside a `Scroll` an
// `Expand` that opens below the fold brings its own top edge into view — otherwise the rows below
// it travel under a stationary cursor, which is principle 2 violated through a mechanism §16.3 does
// not cover: `visible` keeps a cell, and a scroll offset is not a cell.
//
// **`body-height` is pushed rather than measured.** An `Expand` whose height is its content's
// preferred height animates against a number that is itself changing, and §8.3's rule is that no
// animation may fail to end.
//
// All three accessibility properties are real and verified in the compiler's own registry
// (`typeregister.rs:264-266`, `:277`).
export component Expand inherits Rectangle {
    in property <bool> open: false;
    in property <length> body-height;

    callback opened();
    callback closed();

    // **The animated length is a named property, and `height` reads it** rather than the other way
    // round. `root.height` is banned in this markup (§16.1) — the vertical axis is where the binding
    // loop closes, and `nothing_in_the_markup_reads_the_windows_own_height` is a text sweep that
    // cannot tell an `Expand`'s `root` from the window's. One property is cheaper than an exemption.
    property <length> shown: root.open ? root.body-height : 0px;
    animate shown {
        duration: Motion.gentle;
        easing: ease-out-quart;
    }
    height: root.shown;
    clip: true;
    // Out of the tab order and out of the accessible tree the moment it has finished closing —
    // and still drawn while it is closing, which is the same argument the drawer's own `on-screen`
    // makes one level up.
    visible: root.shown > 0px;

    accessible-role: AccessibleRole.groupbox;
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-expand => {
        if (root.open) {
            root.closed();
        } else {
            root.opened();
        }
    }

    changed open => {
        if (root.open) {
            root.opened();
        } else {
            root.closed();
        }
    }

    @children
}

// ─── Check (§11.3) ──────────────────────────────────────────────────────────────────────────────
//
// **Every box ticks.** `compose.rs`'s doctrine is that a checkbox you cannot tick is a question you
// cannot ask: it tells you *that* something is impossible and never *why*. So a refused system is
// drawn disabled with its reason and its escape hatch — `Pressable`'s whole construction — rather
// than being absent.
//
// The box is a `Rectangle` with a `1px` hairline border and the **existing** `check` icon inside,
// so §6.7's drawn set stays closed at sixteen.
export component Check inherits Pressable {
    in property <bool> on: false;

    pad: Geometry.page-margin;

    accessible-role: AccessibleRole.checkbox;
    accessible-checkable: true;
    accessible-checked: root.on;

    Rectangle {
        width: Metric.s5;

        Rectangle {
            x: 0;
            y: (parent.height - self.height) / 2;
            width: Metric.s4;
            height: Metric.s4;
            border-width: 1px;
            border-color: root.enabled ? Ink.line : Ink.fg-disabled;
            border-radius: 1px;
            background: root.on && root.enabled ? Ink.accent : Ink.bg;

            Icon {
                kind: "check";
                ink: #ffffff;
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                visible: root.on;
            }
        }
    }

    Text {
        text: root.label;
        font-size: Metric.body-size;
        font-weight: Metric.weight-body;
        color: root.enabled ? Ink.fg : Ink.fg-disabled;
        overflow: elide;
        vertical-alignment: center;
    }
}

// ─── ToggleRow (§11.6) ──────────────────────────────────────────────────────────────────────────
//
// A full-width settings row with the box trailing. **The markup never writes the state** — it fires
// `activated()` and Rust flips the model and pushes it back, so there is one writer, which is the
// same rule `nav::Stack` gets for where you are.
export component ToggleRow inherits Pressable {
    in property <bool> checked: false;

    pad: Geometry.page-margin;

    accessible-role: AccessibleRole.checkbox;
    accessible-checkable: true;
    accessible-checked: root.checked;

    Text {
        horizontal-stretch: 1;
        min-width: 0px;
        text: root.label;
        font-size: Metric.body-size;
        font-weight: Metric.weight-body;
        color: root.enabled ? Ink.fg : Ink.fg-disabled;
        overflow: elide;
        vertical-alignment: center;
    }

    Rectangle {
        width: Metric.s4;

        Rectangle {
            x: 0;
            y: (parent.height - self.height) / 2;
            width: Metric.s4;
            height: Metric.s4;
            border-width: 1px;
            border-color: root.enabled ? Ink.line : Ink.fg-disabled;
            border-radius: 1px;
            background: root.checked && root.enabled ? Ink.accent : Ink.bg;

            Icon {
                kind: "check";
                ink: #ffffff;
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                visible: root.checked;
            }
        }
    }
}

// ─── A drawer page's header (§11.2, §11.6) ──────────────────────────────────────────────────────
//
// `‹ Close  |  Work` — the way out is always in the same place, and **the back control is never
// disabled**: every surface can be left (§4, and `every_surface_can_be_left` is the test).
//
// `back` is `Close` at depth 0 and the parent page's name below that.
//
// It lives in `primitives.slint` rather than in `drawer.slint`, which is where the contract put it,
// because `drawer.slint` imports `work.slint` for the depth-1 slot and `work.slint` needs this
// header — a cycle. A page header is a page primitive; this is where it belongs anyway.
export component DrawerHeader inherits Rectangle {
    in property <string> back;
    in property <string> title;
    callback back-pressed();

    height: Geometry.drawer-header-h;
    background: @linear-gradient(180deg, Ink.bg-band-top 0%, Ink.bg-band-bottom 100%);

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Ink.line.with-alpha(0.5);
    }

    // No `alignment` — see the note in `Pressable`.
    HorizontalLayout {
        padding-left: Metric.s3;
        padding-right: Geometry.page-margin;

        Pressable {
            label: root.back;
            activated => {
                root.back-pressed();
            }

            Rectangle {
                width: Metric.s4;
                Icon {
                    kind: "back";
                    ink: Ink.accent;
                    x: 0;
                    y: (parent.height - self.height) / 2;
                    width: Metric.s3;
                    height: Metric.s3;
                }
            }

            Text {
                text: root.back;
                font-size: Metric.body-size;
                font-weight: Metric.weight-body;
                color: Ink.accent;
                vertical-alignment: center;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Text {
            text: root.title;
            font-size: Metric.title-size;
            font-weight: Metric.weight-title;
            color: Ink.fg;
            vertical-alignment: center;
        }
    }
}

// ─── Scroll (§5, §16.11) ────────────────────────────────────────────────────────────────────────
//
// The body of a drawer page, between its fixed header and any pinned footer. **Never the bench,
// never the shelf, never the well, never the cradle, never fullscreen, never inside another Scroll
// (`SCROLL_FILTER_DURATION` is 800 ms), never around anything draggable (`DISTANCE_THRESHOLD` is
// 8 px), and never around the drawn iPod at any size.**
//
// **`interactive: false`, and it retires an accepted limitation.**
// `Flickable::input_event_filter_before_children` returns `ForwardAndIgnore` for every non-wheel
// event when `interactive` is false (`i-slint-core-1.17.1/items/flickable.rs:155-158`), and
// `input_event` returns `EventIgnored` on the same condition (`:167-170`) — so
// `handle_mouse_filter`, and with it `DelayForwarding(FORWARD_DELAY)`, is never reached. **Wheel
// events fall through in both places**, so the wheel and the trackpad still scroll. §19.4's *"every
// control inside a drawer page's Scroll is 100 ms late to a press"* is retired; what replaces it is
// **no touch-drag-to-flick**, which matters on a touchscreen laptop and not on a trackpad.
//
// **The use site's obligation, and it is not optional.** The single child is a `VerticalLayout`
// whose width is the Scroll's own and whose children read NOTHING of the Scroll's height, and
// `viewport-height` must be bound explicitly. Slint computes it automatically only from direct
// children that are layout elements **and are not repeated**
// (`i-slint-compiler-1.17.1/passes/flickable.rs:181-196`, carrying the FIXME for upstream #407) —
// and the Rail is a `for`. Left unset, the Rail reports a viewport of zero, the Scroll declines to
// scroll, and the entries past the fold are positioned outside the Flickable and drawn there. It
// looks fine and it is wrong.
export component Scroll inherits Rectangle {
    in property <length> viewport-height;
    out property <bool> more-above: flick.viewport-y < 0px;
    out property <bool> more-below: flick.height - flick.viewport-y < root.viewport-height;

    // §8.1 item 3 / §16.11: an Expand — or a Tab stop — below the fold scrolls its own top edge
    // into view rather than letting the rows below it travel under a stationary cursor.
    //
    // **`absolute-position` is read HERE, inside a function called from a callback, and never in a
    // binding**: the compiler ships `tests/syntax/analysis/binding_loop_mappointtowindow.slint` for
    // exactly that shape.
    public function ensure-visible(absolute-top: length, h: length) {
        let local = absolute-top - flick.absolute-position.y;
        if (local < 0px) {
            flick.viewport-y += -local;
        }
        if (local + h > flick.height) {
            flick.viewport-y -= local + h - flick.height;
        }
    }

    clip: true;

    flick := Flickable {
        interactive: false;
        // Never sideways.
        viewport-width: self.width;
        viewport-height: root.viewport-height;
        vertical-stretch: 1;
        // Pinned to zero so this container reports no intrinsic height of its own and takes what
        // the page has left — §16.1, one level down from the window.
        min-height: 0px;
        preferred-height: 0px;

        animate viewport-y {
            duration: Motion.gentle;
            easing: ease-out-quart;
        }

        @children
    }

    // `visible`, not `if`: no cell is at stake and `if` would destroy and rebuild the subtree
    // (§16.3).
    Icon {
        kind: "collapse";
        ink: Ink.fg-dim;
        x: parent.width - Metric.s4;
        y: 0;
        width: Metric.s3;
        height: Metric.s3;
        visible: root.more-above;
    }

    Icon {
        kind: "expand";
        ink: Ink.fg-dim;
        x: parent.width - Metric.s4;
        y: parent.height - Metric.s3;
        width: Metric.s3;
        height: Metric.s3;
        visible: root.more-below;
    }
}
