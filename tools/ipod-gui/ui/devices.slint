// The Devices page — docs/GUI.md §7.2, §9.1, §9.4, §11.4, §16.11.
//
// **Device selection lives here, not on the bench.** §7.2 settles a question the previous revision
// left open and which reproduced the disease this whole design is a cure for: *one device on screen*
// plus a `←`/`→` that switched devices meant that looking at a second iPod either destroyed the first
// or left an ARM7 executing behind a panel that was no longer drawn. So while there is a machine the
// bench draws it and only it, and every other device is read about here — the parts it is made of,
// where it writes, and `Start`, disabled while a machine exists with the machine-rule reason that
// names it.
//
// **A device that cannot start says which path is missing.** `Settings::missing()` stats every
// resolved path and returns `Absent::Gone(PathBuf)` or `Absent::Unlisted(String)`, and
// `devices::gone_sentence` words both — the same function the cradle and the Rail call, so the three
// surfaces cannot say three things about one device.
//
// **`start-device(int)` and `selected` are REUSED, not duplicated.** This page presses the callback
// the bench's own centre button presses and writes the same index, which is what makes
// `the_devices_page_and_the_bench_read_one_model` mean anything.
//
// This page states no policy and words no sentence. Its literals are its own page name and its two
// verbs.

import { Ink, Metric } from "tokens.slint";
import { Geometry } from "@geometry";
import {
    DetailRow,
    DeviceRow,
    DrawerHeader,
    Expand,
    FixRow,
    Pressable,
    Row,
    Scroll,
} from "primitives.slint";

// ─── One line inside an expanded device (§7.2) ──────────────────────────────────────────────────
//
// `devices::made_of` — `iPod`, `Drive`, `Built from`, `Installed`, `Writes to`. It must **not** call
// `nor::Source::describe`, which interpolates `id.serial` into its sentence; the iPod line is
// `settings::suggest_ipod_name` plus the resource name, and that rule lives in Rust because this is
// where a leak would be invisible.
export component MadeOfLine inherits VerticalLayout {
    in property <DetailRow> d;
    in property <int> index;

    callback act(int, int);
    callback reveal(length, length);

    spacing: 0px;

    if root.d.has-action: Pressable {
        label: root.d.act-label;
        enabled: root.d.enabled;
        reason: root.d.reason;
        escape-hatch: root.d.escape-hatch;
        machine-rule: root.d.machine-rule;
        presses: root.d.presses;
        consequence: root.d.consequence;
        pad: Geometry.page-margin;
        activated => {
            root.act(root.d.action, root.index);
        }
        gained-focus => {
            root.reveal(self.absolute-position.y, self.height);
        }

        Text {
            text: root.d.act-label;
            font-size: Metric.body-size;
            font-weight: Metric.weight-strong;
            // **The act's own answer, and it used to be a literal `Ink.danger`** — so `Edit…`, the
            // first line on this page that is not a removal, was drawn in the destructive colour.
            // `parts.slint` draws the same struct through the same flattener and said `Ink.accent`;
            // one struct cannot have two colours. `parts::RowAction::destructive` decides.
            color: !root.d.enabled
                ? Ink.fg-disabled
                : (root.d.destructive ? Ink.danger : Ink.accent);
            overflow: elide;
            vertical-alignment: center;
        }
    }

    if !root.d.has-action && root.d.mono: Text {
        text: root.d.value;
        font-family: Metric.mono-family;
        font-size: Metric.mono-size;
        color: Ink.fg-dim;
        wrap: word-wrap;
    }

    // A labelled fact — `devices::device_fact`, and every one of the five has a label.
    //
    // **Not a `HorizontalLayout`, and the reason is a line this page was dropping on the floor.**
    // The value was a `wrap: word-wrap` `Text` with `horizontal-stretch: 1` in a layout row, and a
    // wrapping `Text` reports the *unwrapped* width as its preferred one — so the row was sized for
    // a single line and the second was **clipped, with no ellipsis**. Read it off
    // `_out/gui/devices.png`: `Writes to` drew `works on a copy of my-5.5g.img \u{2014} nobody has` and
    // stopped, with 20 px of blank under it and nothing on screen saying anything was missing. The
    // same sentence draws whole on the shelf three rows down in the same frame, which is what made
    // it a defect rather than a budget.
    //
    // So the value gets an explicit `width` and the row's height is the value's own
    // `preferred-height`, which Slint computes at that width. That is the arrangement this file
    // already uses for its empty-page line and its machine rule; a layout cell is what could not
    // measure it.
    if !root.d.has-action && !root.d.mono && root.d.label != "": fact := Rectangle {
        // **The line count is arithmetic on a measured width, not `preferred-height`.** Slint's
        // vertical `layout_info` for a wrapping `Text` answered 24 px for a sentence that draws in
        // two 16 px lines — it under-reports, which is the same shape as the defect above it and
        // would have left the second line overflowing a row that merely *looked* right because the
        // 8 px of `spacing` under it happened to absorb the difference. So the natural width is
        // measured off a hidden non-wrapping twin and divided by the column, which is what
        // `every_fact_this_page_draws_is_drawn_whole` computes on the other side of the same sum.
        property <length> column: fact.width - Geometry.field-label-w - Metric.s2;
        property <int> lines: max(1, Math.ceil(natural.preferred-width / fact.column * 1.0));

        height: fact.lines * Geometry.line-label;
        clip: true;

        // Outside every layout and never drawn: this is the same trick `window.slint`'s six probes
        // use, and it is the only way to ask this toolkit how wide a string wants to be.
        natural := Text {
            visible: false;
            text: root.d.value;
            font-size: Metric.label-size;
            font-weight: Metric.weight-label;
        }

        Text {
            x: 0;
            y: 0;
            width: Geometry.field-label-w;
            height: Geometry.line-label;
            text: root.d.label;
            font-size: Metric.label-size;
            font-weight: Metric.weight-label;
            color: Ink.fg-dim;
            overflow: elide;
            vertical-alignment: center;
        }

        Text {
            x: Geometry.field-label-w + Metric.s2;
            y: 0;
            width: fact.column;
            height: parent.height;
            text: root.d.value;
            font-size: Metric.label-size;
            font-weight: Metric.weight-label;
            color: Ink.fg;
            wrap: word-wrap;
        }
    }

    // §9.4's machine rule — `devices::device_rule`, which carries no label. **It used to fall into
    // the branch above**, so a sentence about a part that has left the library was drawn as a
    // value in the fact column: indented past an empty label, wrapped into two thirds of the
    // width, at `label-size`. It is prose, it is the one line on the page whose teaching is the
    // point, and `parts.slint` has drawn it this way since it was written — one struct, one
    // rendering, on both pages that draw it.
    if !root.d.has-action && !root.d.mono && root.d.label == "": Text {
        text: root.d.value;
        font-size: Metric.body-size;
        font-weight: Metric.weight-body;
        color: root.d.machine-rule ? Ink.fg : Ink.fg-dim;
        wrap: word-wrap;
    }
}

export component DevicesPage inherits Rectangle {
    in property <[DeviceRow]> devices;
    // `in`, not `in-out`: this page fires `select(i)` and Rust is the single writer, exactly as
    // `nav::Stack` is for where you are. Four entrances writing one piece of state from four sides
    // is how `Esc` came to have three meanings.
    in property <int> selected: 0;
    in property <[DetailRow]> detail;
    in property <int> detail-of: -1;
    // §9.1: `No devices yet.` — one non-interactive `fg-disabled` line above the always-present
    // `+ New device ›`. The sentence is the model's, not this file's.
    in property <string> empty-line;
    in property <FixRow> new-device;
    // §7.2's `Start`, for the **one open device**, from `devices::start_row`.
    //
    // **Not `d.startable` and `d.cradle-label`.** Those two are the bench's cradle as well —
    // `window.slint:806` reads `root.current.cradle-label` and `:789` `root.current.startable`,
    // for the drawn iPod — so §7.2's refusal, *a machine
    // exists, stop it first*, would be printed under the machine telling the operator to stop it.
    // One field, two surfaces, and only one of them is asking this page's question.
    //
    // One row is enough for a page of nine devices because a closed `Expand` has
    // `visible: root.shown > 0px` (`primitives.slint:1065`), so the control exists on screen for
    // the open row and no other.
    //
    // **`start-row`, not `start`** — the same trap `start-device` was named around, four lines
    // down: `start` is `LayoutAlignment`'s own value, so a property of that name makes
    // `alignment: start;` two hundred lines below stop compiling with *Cannot convert FixRow to
    // enum LayoutAlignment*, which points at the alignment rather than at the name.
    in property <FixRow> start-row;

    callback back-pressed();
    callback expand(int, bool);
    callback select(int);
    // **`start-device`, not `start`.** `start` is `LayoutAlignment`'s own value, and a callback of
    // that name shadows it — `alignment: start;` two hundred lines down stops compiling with
    // *"Callback must be called"*, which points at the alignment rather than at the name.
    callback start-device(int);
    callback row-action(int, int);
    callback new-pressed();

    background: Ink.bg;
    accessible-role: AccessibleRole.region;
    accessible-label: "Devices";

    VerticalLayout {
        spacing: 0px;

        DrawerHeader {
            back: "Menu";
            title: "Devices";
            back-pressed => {
                root.back-pressed();
            }
        }

        scroll := Scroll {
            vertical-stretch: 1;
            min-height: 0px;
            preferred-height: 0px;
            viewport-height: body.preferred-height;

            body := VerticalLayout {
                width: scroll.width;
                padding-top: Metric.s3;
                padding-bottom: Metric.s3;
                spacing: 0px;
                alignment: start;
                accessible-role: AccessibleRole.list;
                accessible-label: "Devices";

                if root.devices.length == 0: Text {
                    x: Geometry.page-margin;
                    // The same inset `ui/parts.slint`'s empty line needed: binding `x` inside a
                    // layout moves the paragraph and does not narrow it, so a sentence longer than
                    // this page's `No devices yet.` would run off the drawer's right edge.
                    width: parent.width - 2 * Geometry.page-margin;
                    text: root.empty-line;
                    font-size: Metric.body-size;
                    font-weight: Metric.weight-body;
                    color: Ink.fg-disabled;
                    wrap: word-wrap;
                }

                for d[i] in root.devices: VerticalLayout {
                    spacing: 0px;

                    row := Row {
                        index: i;
                        count: root.devices.length;
                        label: d.name;
                        // §7.5's row-1 trailing slot, on the page as on the shelf: the state, and
                        // the time since. One producer, `devices::shelf_state`.
                        value: d.state;
                        sub: d.summary;
                        selected: i == root.selected;
                        chevron: true;
                        activated => {
                            root.select(i);
                            root.expand(i, root.detail-of != i);
                        }
                        gained-focus => {
                            scroll.ensure-visible(self.absolute-position.y, self.height);
                        }
                    }

                    expand := Expand {
                        open: root.detail-of == i;
                        body-height: detail-body.preferred-height;
                        opened => {
                            scroll.ensure-visible(row.absolute-position.y, row.height + expand.body-height);
                        }

                        detail-body := VerticalLayout {
                            padding-left: Geometry.page-margin;
                            padding-right: Geometry.page-margin;
                            padding-top: Metric.s2;
                            padding-bottom: Metric.s2;
                            spacing: Metric.s2;
                            alignment: start;

                            // The ternary is a property rather than the `for`'s own expression: a
                            // conditional inside `for x in <expr>:` puts a `:` where the parser is
                            // looking for the one that introduces the element.
                            property <[DetailRow]> mine: root.detail-of == i ? root.detail : [];

                            for line in mine: MadeOfLine {
                                d: line;
                                index: i;
                                act(a, n) => {
                                    root.row-action(a, n);
                                }
                                reveal(top, h) => {
                                    scroll.ensure-visible(top, h);
                                }
                            }

                            // §7.2: **`Start` is disabled with a reason**, and the reason names the
                            // path. `Absent::Gone(PathBuf)` and `Absent::Unlisted(String)` are both
                            // reachable and `missing()` stats the filesystem, so this is the one
                            // refusal this program can already produce — and it is a machine rule,
                            // because a file that is not there cannot be read by anything.
                            Pressable {
                                label: root.start-row.label;
                                enabled: root.start-row.enabled;
                                reason: root.start-row.reason;
                                escape-hatch: root.start-row.escape-hatch;
                                // **Computed, not `true`.** It was a literal, and it is wrong for
                                // the composed-and-unbuilt device: *building a composed device is
                                // not wired yet* is §9.4's other kind — a project state — and
                                // drawing it in `fg` as a law of physics tells the reader this
                                // program will never do it. `devices::start_row` decides.
                                machine-rule: root.start-row.machine-rule;
                                presses: root.start-row.presses;
                                consequence: root.start-row.consequence;
                                // **No `primary`, and it used to have one.** §6.5 use 2 is *the
                                // one primary row on a drawer page \u{2014} one per page, never two*,
                                // and this page drew two: this control and the pinned
                                // `+ New device` footer, whose own note four elements below calls
                                // itself *the page's one material row*. `_out/gui/devices.png` has
                                // both in one frame, plus the selected shelf row on use 1, which
                                // is three blues down one 420 px column. The footer keeps it: it
                                // is the page's action in every state including the empty one,
                                // which is what §9.1 put it outside the `Scroll` for. This is an
                                // act inside an open row, and it reads as one \u{2014} `Ink.accent`,
                                // the way `Edit\u{2026}` two rows above it does.
                                pad: Geometry.page-margin;
                                activated => {
                                    root.select(i);
                                    root.start-device(i);
                                }
                                gained-focus => {
                                    scroll.ensure-visible(self.absolute-position.y, self.height);
                                }

                                Text {
                                    text: root.start-row.label;
                                    font-size: Metric.body-size;
                                    font-weight: Metric.weight-strong;
                                    // `Ink.accent`, not `#ffffff` \u{2014} white was for the material
                                    // this control no longer wears, and it would have drawn white
                                    // on `bg-raised` the moment the row was selected.
                                    color: root.start-row.enabled ? Ink.accent : Ink.fg-disabled;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── `+ New device ›`, pinned (§9.1, §16.11) ──
        //
        // **Always present**, outside the Scroll, and the page's one material row — because an empty
        // Devices page whose only action had scrolled away is §9.1's *bare "nothing here"* wearing a
        // list. Its label and its refusal are the model's: the Composer is a page this build has, so
        // it is enabled; the day it is not, `rail::Caps` withdraws it and the reason returns with it.
        Rectangle {
            height: max(Geometry.primary-footer-h, new.height + 2 * Geometry.footer-pad);
            background: Ink.bg-raised;

            Rectangle {
                y: 0;
                height: 1px;
                background: Ink.line.with-alpha(0.3);
            }

            new := Pressable {
                x: Geometry.page-margin;
                y: Geometry.footer-pad;
                width: parent.width - 2 * Geometry.page-margin;
                label: root.new-device.label;
                enabled: root.new-device.enabled;
                reason: root.new-device.reason;
                escape-hatch: root.new-device.escape-hatch;
                machine-rule: root.new-device.machine-rule;
                presses: root.new-device.presses;
                consequence: root.new-device.consequence;
                primary: true;
                pad: Geometry.page-margin;
                activated => {
                    root.new-pressed();
                }

                Text {
                    text: root.new-device.label;
                    font-size: Metric.body-size;
                    font-weight: Metric.weight-strong;
                    color: root.new-device.enabled ? #ffffff : Ink.fg-disabled;
                    horizontal-alignment: center;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }
    }
}
