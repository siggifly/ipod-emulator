// The design tokens — docs/GUI.md §7.
//
// **The light palette is measured, not chosen.** Every value below was sampled from
// docs/media/ipod-03-main-menu.png, a frame this emulator drew, by walking a vertical strip through
// RetailOS's own chrome. The accent is the blue the iPod itself uses to say *this one*.
//
// What is deliberately NOT borrowed: the pixel grid. No pixel fonts, no faux-LCD, no scanlines,
// nothing that could make our chrome mistakable for the emulated screen — because being able to
// tell which layer a screenshot is of is this project's whole discipline.

export global Ink {
    out property <color> bg: #ffffff;
    out property <color> bg-raised: #f7f7ff;
    out property <color> bg-band-top: #eff3f7;
    out property <color> bg-band-bottom: #c6cbce;
    out property <color> bg-sunken: #c6cfd6;
    out property <color> fg: #000000;
    out property <color> fg-dim: #5a616b;
    out property <color> fg-disabled: #9aa0a8;
    out property <color> line: #848ea5;

    // **A separator is not a border, and drawing both with one colour is why every list on this
    // surface reads as a table** (§6.4, 2026-09-07). `line` #848ea5 is 2.08 : 1 on the well and
    // 3.28 : 1 on `bg` — the right weight for the edge of a *region*, and far too much for the hair
    // between two rows of one list, which a reader is supposed to feel rather than see. This is
    // that hair: the same hue, lightened until it separates and stops dividing. **1.30 : 1 on
    // `bg`**, which is deliberately below every legibility floor in this document because it is not
    // carrying information — the rows are.
    //
    // It is a measured value rather than `line.with-alpha(…)` so `palette()` can read it: the
    // contrast tests parse six hex digits out of this file, and an alpha expression is invisible
    // to them.
    out property <color> separator: #dfe2ea;

    // RetailOS's selection blue. 5.14:1 on white — clears AA for white text on the fill.
    out property <color> accent: #2969d6;

    // **The label on the material, and it was written `#ffffff` at ten call sites** (§6.5,
    // 2026-09-07). Five of them are in `primitives.slint`, and the other five are one page each —
    // which is exactly how a palette comes to have a colour nobody can find. It is white, it is
    // white for a stated reason (5.14 : 1 on the accent fill, §6.4), and a call site that wants to
    // know what a label on the material is should be able to ask rather than know.
    //
    // **Not `bg`**, which is also #ffffff today and is a different fact: `bg` is the colour of a
    // drawer page, and a dark scheme moves it to #121212 while this one has to stay white or the
    // label vanishes into its own fill.
    out property <color> on-material: #ffffff;

    // **The focus ring's outer half** — §6.4's accent at the alpha a halo is drawn at, so the ring
    // is a soft edge rather than a second hard stroke (§23, 2026-09-07). Declared here rather
    // than written as `Ink.accent.with-alpha(…)` at the two call sites, for `material-opacity`'s
    // reason one section down: a number spelled twice is a number that comes apart.
    out property <color> focus-halo: #2969d63d;

    // The material (§7): a 1px darker top rule, a bright band under it, a fall to the bottom edge.
    // Dark edge, highlight beneath, falloff — the whole of the era's vocabulary.
    out property <color> material-rule: #2969d6;
    out property <color> material-top: #5a9aef;
    out property <color> material-bottom: #4a86de;

    // §12.2's `Off` glass, and §11.4's boot-screen preview around it. **One token, two readers** —
    // the drawn iPod's panel and the preview in Parts are the same black and drifting apart would be
    // two answers to *what does a powered-off panel look like*. It is a measured colour, not a
    // derived one: a powered-off 5G's glass, never a frozen last frame.
    out property <color> glass: #08080a;

    out property <color> warn: #9a6700;

    // §6.4. 4.14:1 on `bg-sunken`, 5.9:1 on `bg` — the only role that reads as *this destroys
    // something*: a failed Rail entry, `Remove`, a stopped machine.
    out property <color> danger: #b3261e;
}

// ─── Motion (§8) ────────────────────────────────────────────────────────────────────────────────
//
// **Three durations, and the reduced-motion multiplication is inside this global rather than at
// every use site.** A use site writes `Motion.gentle` and cannot get it wrong; a use site writing
// `Metric.gentle * Motion.scale` can forget the multiplier, and a forgotten one is a silent
// reduced-motion hole that no test would see.
//
// **Slint has no reduced-motion signal of its own** — a grep for `reduced.motion` across
// `i-slint-core`, `i-slint-common` and `builtins.slint` returns nothing — so `scale` is read per
// platform in Rust (macOS `NSWorkspace.accessibilityDisplayShouldReduceMotion`, Windows
// `SPI_GETCLIENTAREAANIMATION`, otherwise false) and pushed in as 1.0 or 0.0.
//
// **`scale: 0.0` lands on the animation's final value rather than freezing it.** Verified rather
// than assumed, because the whole of reduced motion rests on it:
// `i-slint-core-1.17.1/properties_animations.rs:123-125` short-circuits `duration <= 0` to
// `AnimationState::Done`, and `Done` returns `to_value` (`:156-161`). The structural change still
// happens; only its animation does not.
//
// The curve belongs to the token and is never authored at a call site: `tight` is `ease-out-quad`,
// `gentle` is `ease-out-quart`, `wake` is `ease-out-quad`, `lively` is `ease-out-back`, progress is
// `linear`. Slint has no spring easing, so §8 retires the spring vocabulary outright rather than
// keeping it as a fiction.
export global Motion {
    in property <float> scale: 1.0;

    // press, hover, cradle colour, device cross-dissolve, drop-band content
    out property <duration> tight: 140ms * scale;
    // drawer in and out, the device's `x`, Expand height, scroll-into-view
    out property <duration> gentle: 320ms * scale;
    // **§8.1 item 6, and it is a fourth token rather than a literal at one call site.** The wake is
    // 220 ms `ease-out-quad`; §8's table has no 220 ms row, so the first cut reached for `gentle`
    // (320 ms) and paired it with `ease-out-quad`, which is `tight`'s curve — the one call site in
    // the program pairing one token's duration with another's curve. A named token cannot be got
    // wrong that way and cannot forget the reduced-motion multiplication either.
    out property <duration> wake: 220ms * scale;
    // **drawer page depth only, and there is exactly one use site in the program** — `strip.x` in
    // `drawer.slint`. `lively` overshoots (§8.2 rule 2), so a second use site is a design change
    // rather than a convenience.
    out property <duration> lively: 260ms * scale;
}

export global Metric {
    // The closed space scale. Nothing between these steps.
    out property <length> s1: 4px;
    out property <length> s2: 8px;
    out property <length> s3: 12px;
    out property <length> s4: 16px;
    out property <length> s5: 24px;
    out property <length> s6: 32px;
    out property <length> s7: 48px;

    // **Three sizes, not five, and the jumps are large enough to see** (§6.2, revised 2026-09-07).
    //
    // What shipped was 20 / 14 / 13 / 12 — four sizes, three of them inside two pixels of each
    // other. At that spacing a size is not a hierarchy: `label` at 12 and `mono` at 13 differ by
    // less than the hinting does, so what actually told a heading from a body line was **colour**,
    // and the page came out flat and grey. The scale is now **22 / 14 / 12**, and the two changes
    // that got it there are stated rather than left as new numbers:
    //
    //   * **`title` 20 → 22.** Against a 14 px body, 20 reads as body-that-got-bigger; 22 is a
    //     ratio of 1.57 and reads as a heading. Its line box moves with it — `LINE_TITLE` 26 → 28
    //     — and so do the two column sums that hold it, which is what
    //     `the_column_terms_sum_to_the_declared_chrome` is for.
    //   * **`mono` 13 → 12, onto `label`'s step.** A monospace face set at the same nominal size as
    //     a proportional one reads a size larger, because its em is wider and its x-height sits
    //     high; 12 mono beside 14 body is the optical match 13 was reaching for. It also deletes a
    //     size: `label` and `mono` are now one step wearing two faces, which is what a scale with
    //     large jumps has to do when a surface needs both.
    //
    // `display` stayed retired: a 30 px device name floating over a 656 px rendering of that same
    // device is redundant, and its line box was eating 36 px of a vertical budget with none to
    // spare. The shelf's name row is `title`.
    //
    // **`LINE_MONO` deliberately did not move with `mono-size`.** It is 18, `LINE_LABEL` is 16, and
    // the two sum to `FIELD_REASON` 34 exactly — the escape-hatch line and the reason line inside
    // one reserved slot. Shrinking the face inside a fixed box buys legibility for free; shrinking
    // the box would move §9.4's whole budget family for nothing.
    out property <length> title-size: 22px;
    out property <length> body-size: 14px;
    out property <length> label-size: 12px;
    // §6.2's `mono` — paths, hashes, serials, addresses, byte counts.
    out property <length> mono-size: 12px;

    // **One `font-family` string, no fallback list** (§16.6). Slint takes exactly one per element
    // and appends only `SansSerif` then `SystemUi`
    // (`i-slint-common-1.17.1/sharedfontique.rs:188-192`); an unknown family renders in sans-serif
    // with no error, and a missing GLYPH falls to `.notdef` — the twelve empty squares. So the
    // family is chosen per platform in Rust and pushed in here.
    //
    // `in`, not `out`: an `out` global property has no generated setter, so the `out` form cannot
    // be pushed from Rust at all.
    //
    // There is deliberately no `ui-family` beside it. §6.2 wants the system UI face, and an element
    // with no `font-family` binding already gets it; pushing one would oblige every `Text` in the
    // program to name it, for nothing.
    in property <string> mono-family;

    // §6.2's weights. `font-weight: 600` is a role, never inlined — it was inlined in six places in
    // `window.slint`, and that is corrected at the token file rather than per call site.
    out property <int> weight-title: 600;
    out property <int> weight-strong: 600;
    out property <int> weight-body: 400;
    out property <int> weight-label: 500;
}
