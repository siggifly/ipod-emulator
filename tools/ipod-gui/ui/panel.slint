// The panel, in a window of its own — docs/GUI.md §21.7.
//
// **A second VIEW, never a second machine.** §15 rules out *"a second window, tear-off panels,
// multiple machines"* on the grounds that there is exactly one machine by design, and §21.7 narrows
// that rather than contradicting it: that argument is about a second *machine* and does not reach a
// second view of one framebuffer. There is still one machine, one `emu::Link`, one 320 x 240
// texture — and two windows drawing it.
//
// **The iPod keeps its screen.** Both draw the same `screen-source`, so closing this window can
// never strand anything: the frame it was showing is the frame the drawn iPod is already showing,
// and there is no state here to lose. That is what makes this safe in a way a tear-off is not.
//
// **The setup it exists for**: the screen fullscreen on a television, the iPod and its wheel on the
// laptop. Both windows take the keyboard; the wheel is drawn on the main one and stays there.
//
// # What this file does not do
//
// It draws one `Image` and forwards keys. Every number on it is computed in Rust —
// `geometry::panel_k` is §12.6's own rule, and this markup never divides anything — and every
// sentence on it is pushed. There is no wheel here, no cradle, no chrome and no controls: a control
// this window drew would be a second one for something the main window already has, and §21.7 asks
// for a view rather than a second front end.

import { Ink } from "tokens.slint";
// Generated by build.rs from src/geometry.rs (§16.9). The panel's own pixels and the size this
// window opens at; every other number on this page is computed in Rust and pushed.
import { Geometry } from "@geometry";

export component PanelWindow inherits Window {
    // Named for what it is showing rather than for the program, because it sits beside the main
    // window in the switcher and two entries called `ipod-emulator` are two entries nobody can tell
    // apart.
    title: "iPod — panel";
    // §12.6: the whole display, `bg-sunken`, hard-edged. Never a white flash while the layout
    // settles, which is the same reason `MainWindow` sets its own.
    background: Ink.bg-sunken;
    // Bounds rather than a fixed size, so the operator can drag it to any shape and `panel_k` picks
    // the largest whole-number scale that fits. The minimum is a 1:1 panel with nothing around it,
    // and it opens at 2x — both out of `src/geometry.rs`, because §16.9's rule is that every size
    // in this markup comes from there and a `320px` here would be the panel's own resolution typed
    // a second time.
    min-width: Geometry.panel-px-w;
    min-height: Geometry.panel-px-h;
    preferred-width: Geometry.panel-win-pref-w;
    preferred-height: Geometry.panel-win-pref-h;
    forward-focus: keys;

    /// The one texture, the same one the drawn iPod is given. Pushed by `main.rs` on the same tick.
    in property <image> source;
    /// §12.6's own state sentence, for an assistive technology. Pushed, never worded here.
    in property <string> description;
    /// Where the panel is drawn, in logical px — `k × 320` and `k × 240`, computed in Rust from the
    /// **physical** backing store. §12.6's table was wrong for a whole revision because it was
    /// computed in logical pixels against a `k` derived in physical ones, and the way that cannot
    /// happen again is that this markup does no arithmetic at all.
    in property <length> draw-w;
    in property <length> draw-h;

    /// Every key this window takes goes to the same place the main window's do — `machine_key` in
    /// Rust, which is §16.8's one definition. `true` means it was claimed.
    callback key(string, bool) -> bool;
    /// `Esc`, reported rather than handled — `nav::Stack::escape` is the one definition and it
    /// lives in Rust (§16.8). From here its first act is *leave fullscreen*, and its second is to
    /// put this window away.
    callback escape-pressed();
    /// §12.6's fullscreen, reported for the same reason: `full-screen` is a builtin on `Window`
    /// that the compiler generates no accessor for, so the state lives behind `slint::Window`'s own
    /// `is_fullscreen` / `set_fullscreen` and Rust is the one writer of it. A markup property
    /// beside those calls would be a second answer to *is this fullscreen*.
    callback toggle-fullscreen();

    // §12.6: the framebuffer, centred, `image-rendering: pixelated`, hard-edged. **No glass, no
    // border, no glow, no shader** — and no `image-fit`, because fitting is what `draw-w` and
    // `draw-h` already did in whole numbers.
    Image {
        source: root.source;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.draw-w;
        height: root.draw-h;
        image-rendering: pixelated;
        accessible-role: AccessibleRole.image;
        accessible-label: "the iPod's screen";
        accessible-description: root.description;
    }

    keys := FocusScope {
        // §12.6: `⌃⌘F` on macOS, `F11` on Windows and Linux. **On this window rather than on the
        // main one**, because it is this window's own state — §21.7's whole shape is a view you put
        // on a second display and make fullscreen there, while the iPod and its wheel stay where
        // they are.
        //
        // `⌘` is delivered as `Control` on Apple platforms
        // (`i-slint-backend-winit-1.17.1/event_loop.rs:259-274`), so one binding covers both.
        //
        // **Inside the `FocusScope`, because the compiler requires it** — *KeyBinding can only be
        // within a FocusScope element*. `window.slint` has the same arrangement for `⌘\` and `⌘,`.
        //
        // **Both modifiers are named, because ⌃⌘F is two of them and `@keys` matches exactly** —
        // issue #37. This shipped as `@keys(Control + "f")`, which with the swap above is **⌘F**;
        // `Keys::matches` ends `key_event.modifiers == expected_modifiers`
        // (`i-slint-core-1.17.1/input.rs:780`), so the chord this window documents — carrying
        // `{control, meta}` — never fired a binding declaring `{control}`, and ⌘F did something
        // this program never meant to offer. §16.8 writes the rule out for this exact key:
        // *"`⌃⌘F` needs both modifiers, so on Apple platforms it is `@keys(Control + Meta + "F")`"*.
        //
        // Off Apple platforms the same binding is Win+Ctrl+F, which §16.8 records as reserved by the
        // Windows shell and by most compositors and therefore never delivered. That is why `F11`
        // below is not a nicety: it is the whole fullscreen key everywhere but macOS.
        KeyBinding {
            keys: @keys(Control + Meta + "f");
            activated => {
                root.toggle-fullscreen();
            }
        }

        key-pressed(event) => {
            // The other platforms' key. Not a `KeyBinding`, because `F11` carries no modifier and
            // a binding with none would claim the key ahead of anything that wanted it plain.
            if (event.text == Key.F11) {
                root.toggle-fullscreen();
                return accept;
            }
            if (event.text == Key.Escape) {
                root.escape-pressed();
                return accept;
            }
            // The modifier guard §16.8 states, for the reason it states: `event.text` for `⌘M` is
            // still `m`, and without this a ⌘-chord this program does not define would press MENU
            // on the emulated iPod.
            if (!event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta
                && root.key(event.text, true)) {
                return accept;
            }
            return reject;
        }
        // **A key that reaches the machine has to come up as well.** A press with no release is a
        // stuck finger — the same rule, and the same sentence, as the main window's root scope.
        key-released(event) => {
            if (root.key(event.text, false)) {
                return accept;
            }
            return reject;
        }
    }
}
