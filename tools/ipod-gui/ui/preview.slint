// The drawer and the Rail, exercised with a fixture — how to look at this phase's work.
//
// **Why this file exists.** `build.rs` compiles exactly one root, `ui/window.slint`, and nothing
// else in the crate compiles `drawer.slint`, `rail.slint`, `work.slint` or `primitives.slint` on
// their own. So the drawer and the Rail are only ever seen through the bench — and the Rail's five
// interesting states (planned, working, done, failed, cancelled) need real entries pushed into them
// by a program that does not exist until Phase 5.
//
// This root carries six fixture entries covering every `RailKind`, including a failed one with two
// next steps of which the second is disabled with a reason and no escape hatch — the
// `Caps { file_picker: false, drop_target: false }` case, which is the one this build is actually
// in.
//
//     slint-viewer -L geometry=$(find ~/dev/.cargo-target -name geometry.slint | head -1) \
//         tools/ipod-gui/ui/preview.slint
//
// The `-L` is not optional: `@geometry` resolves ONLY through the compiler's library paths
// (`typeloader.rs:1259`), and the file it points at is generated by `build.rs` from
// `src/geometry.rs`, so `cargo build -p ipod-gui` has to have run once.
//
// `tests/markup_discipline.rs` reads the fixture below and fails if it stops covering every
// `RailKind`, so this cannot rot into a fixture of the happy path.

import { Ink, Metric, Motion } from "tokens.slint";
import { Geometry } from "@geometry";
import { Drawer, DrawerHandle, DrawerPage } from "drawer.slint";
import { RailRow, RailKind } from "rail.slint";

export { Motion }

export component Preview inherits Window {
    title: "ipod-emulator — drawer and Rail preview";
    background: Ink.bg-sunken;
    min-width: Geometry.min-width;
    min-height: Geometry.min-height;
    preferred-width: Geometry.pref-width;
    preferred-height: Geometry.pref-height;

    in-out property <bool> open: true;
    in-out property <int> depth: 0;
    in-out property <DrawerPage> page: DrawerPage.none;

    property <length> inset: root.open ? Geometry.drawer-w : 0px;
    animate inset {
        duration: Motion.gentle;
        easing: ease-out-quart;
    }

    // One wrapping element, for the same reason `window.slint` has one: the root `FocusScope` that
    // owns the keyboard sits here in the real window, so everything the drawer needs to be true of
    // its container is true one level down rather than against the `Window` itself.
    //
    // It also happens to be what makes `i-slint-backend-testing`'s `ElementQuery` able to see the
    // drawer at all: `visit_descendants` from a window's root does not report that window's own
    // direct children, only their descendants. Verified with a two-Rectangle probe — the outer one
    // never appears. An empty query from that API is not evidence of an absent element.
    client := Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;

        // Stands in for the bench: the well narrows, and the handle rides its trailing edge rather
        // than the window's, so it moves with the push.
        bench := Rectangle {
            x: 0;
            y: 0;
            width: parent.width - root.inset;
            height: 100%;

            Text {
                x: Geometry.page-margin;
                y: Geometry.page-margin;
                // The bench is composed in `ui/window.slint` and `cargo build` compiles it, so it
                // is not stood in for here. What this root exists for is the drawer, which nothing
                // else opens on its own.
                text: "the bench is in window.slint. This root is the drawer and the Rail.";
                font-size: Metric.body-size;
                color: Ink.fg-dim;
            }
        }

        DrawerHandle {
            open: root.open;
            x: bench.width - Geometry.handle-w;
            y: (bench.height - Geometry.shelf - Geometry.handle-h) / 2;
            toggled => {
                root.open = !root.open;
            }
        }

        Drawer {
            x: parent.width - root.inset;
            y: 0;
            client-height: bench.height;
            open: root.open;
            depth: root.depth;
            page: root.page;
            rail-failures: 1;

            rail-announce: "one step failed";
            // §6.5: the index of the ONE entry allowed to wear the material. Two failures on one
            // page with two primary rows is a page with no primary action.
            rail-first-failure: 4;
            work-heading: "This is what pressing the centre button does";
            work-empty: "Nothing is happening. Fetches, builds and installs report here.";
            ledger-download: "6.5 MB to download";
            // **28, not 240**, and 240 is what §10.1 said until it was measured. An 8 GiB image
            // written by `build_disk` is sparse: an MBR, a 13 895 680-byte firmware partition and
            // a FAT32 volume's own structures. Probed on this filesystem — `truncate` to
            // 8 589 934 592, write those three regions, read `st_blocks` — it costs **18 120 704
            // bytes on disk**, against an apparent 8.6 GB. So the whole first run is the 6 533 633-
            // byte `.ipsw` plus about 21 MB of drive: **28 MB**, and the figure this fixture used
            // to carry was wrong by an order of magnitude in the direction of alarm.
            ledger-disk: "about 28 MB on disk";
            ledger-note: "Nothing has been downloaded yet.";

            rail: [
                {
                    id: 1,
                    kind: RailKind.note,
                    verb: "plan",
                    what: "A 5.5G, 30 GB, black",
                    sub: "Apple 25.1.3, Rockbox 4.0",
                    fraction: -1,
                },
                {
                    id: 2,
                    kind: RailKind.done,
                    verb: "synthesise",
                    what: "A boot ROM",
                    sub: "generated, not dumped",
                    fraction: -1,
                },
                {
                    id: 3,
                    kind: RailKind.working,
                    verb: "fetch",
                    what: "Apple's firmware",
                    // 6 533 633, read off `firmware.rs`'s own catalogue entry for
                    // `iPod_25.1.3.ipsw` — which is the number `verify()` refuses against, and
                    // therefore the only one this line may carry. §10.1's `6 500 352` matches no
                    // release in `CATALOGUE`. No thousands separators, because the producer is
                    // `format!("{} B", rel.bytes)` and a fixture that reads better than the thing
                    // it stands in for is a fixture nobody can trust.
                    sub: "iPod_25.1.3.ipsw - 6533633 B - from Apple, SHA-256 checked",
                    measure: "4.1 MB of 6.5 MB",
                    fraction: 0.63,
                    cancellable: true,
                    cancel-cost: "cancelling deletes iPod_25.1.3.ipsw.part, 4.1 MB right now",
                },
                {
                    id: 4,
                    kind: RailKind.cancelled,
                    verb: "copy",
                    what: "Rockbox 4.0 onto the volume",
                    sub: "you cancelled this",
                    fraction: -1,
                },
                {
                    id: 5,
                    kind: RailKind.failed,
                    verb: "build",
                    what: "my-5.5g.img",
                    sub: "16 777 216 sectors, sparse",
                    fraction: -1,
                    happened: "That folder is on a FAT32 volume. FAT32 cannot hold a file larger than 4 GiB and has no sparse files, so an 8 GiB drive image would be written in full and would stop at exactly 4 294 967 296 bytes.",
                    dismissible: true,
                    next-a-label: "Choose somewhere else",
                    next-a-enabled: false,
                    next-a-reason: "There is no file picker in this build yet.",
                    next-a-escape: "IPOD_EMULATOR_DATA=/path/to/somewhere",
                    next-a-presses: 1,
                    // **Disabled, with a reason and NO escape hatch**, because that is what this
                    // build actually renders: `Next::CopyDetails.available()` is `caps.clipboard`,
                    // which is false — nothing in this dependency graph reaches a pasteboard — and
                    // an unavailable step that offered a command would be pointing at a mechanism
                    // that does not exist. It read `next-b-enabled: true` while the prose above
                    // claimed it was the disabled case; `tests/markup_discipline.rs` is what stops
                    // that happening again.
                    next-b-label: "Copy the details",
                    next-b-enabled: false,
                    next-b-reason: "this build has no clipboard",
                    next-b-presses: 1,
                },
                {
                    id: 6,
                    kind: RailKind.planned,
                    verb: "install",
                    what: "Rockbox into the firmware partition",
                    sub: "never writes to the source",
                    fraction: -1,
                },
                // **§9.3's last row, drawn.** `ToolMissing` is the one class with NO next step —
                // there is no control this program could draw that installs 7-Zip — and what it
                // carries instead is a named command in `mono`. It had no field on `RailRow` at all,
                // so the remedy reached no pixel and this entry drew a paragraph, two invisible
                // controls holding a 78 px band open, and `Dismiss`.
                {
                    id: 7,
                    kind: RailKind.failed,
                    verb: "build",
                    what: "the ZeroSlackr tree",
                    sub: "ZeroSlackr-2010-05-01.7z",
                    fraction: -1,
                    happened: "7z is not on the path, and it is what this step runs.",
                    mono: "brew install p7zip on macOS, apt install p7zip-full on Debian",
                    dismissible: true,
                },
            ];

            close => {
                root.open = false;
            }
            back => {
                if (root.depth > 0) {
                    root.depth -= 1;
                } else {
                    root.open = false;
                }
            }
            go(p, d) => {
                root.page = p;
                root.depth = d;
            }
        }
    }
}
