// The drawn iPod — the one asset that appears on every surface, so it is worth drawing properly.
//
// **Every dimension is derived from `body-height` and nothing else.** That is deliberate: it is what
// makes the device unable to resize itself, which is the bug docs/GUI.md §6 exists to prevent, and
// it means one number changes it from a thumbnail to a hero.
//
// The ratios are Apple's, not eyeballed. iPod 5G is 103.5 × 61.8 mm with a 2.5-inch 4:3 display and
// a ~43 mm click wheel; everything below is that arithmetic:
//
//   body       w/h  = 0.5971
//   screen     w    = 0.4909 h_body     (50.8 mm active area, 82.2 % of body width)
//              h    = 0.3681 h_body     (38.1 mm)
//              top  = 0.0870 h_body     (9 mm of forehead — the first draft had 5 %, which is why
//                                        it looked wrong before anyone could say why)
//   wheel      d    = 0.4155 h_body     (43 mm, 69.6 % of body width)
//              top  = 0.5324 h_body
//   centre     d    = 0.1643 h_body     (17 mm)
//   corner     r    = 0.0386 h_body     (4 mm)

import { Ink } from "tokens.slint";

// The four click-wheel marks. Drawn as vector paths, never as font glyphs — docs/GUI.md §7, written
// after twelve glyphs shipped to the operator as empty squares.
component WheelMark inherits Path {
    in property <string> kind;
    in property <color> ink;
    fill: ink;
    viewbox-width: 12;
    viewbox-height: 8;
    commands: kind == "prev"
        ? "M 5 0 L 0 4 L 5 8 Z M 11 0 L 6 4 L 11 8 Z"
        : kind == "next"
        ? "M 0 0 L 5 4 L 0 8 Z M 6 0 L 11 4 L 6 8 Z"
        : "M 0 0 L 5 4 L 0 8 Z M 7 0 L 8.6 0 L 8.6 8 L 7 8 Z M 10 0 L 11.6 0 L 11.6 8 L 10 8 Z";
}

export component IPod inherits Rectangle {
    in property <length> body-height: 420px;
    in property <color> chassis: #2b2b2d;
    // Passed rather than computed: Slint has no luminance function, and the alternative is the
    // window guessing at a colour's brightness with arithmetic that would be wrong for the gold and
    // green cases.
    in property <bool> dark-chassis: true;
    in property <image> screen-source;
    in property <bool> screen-lit: false;

    callback clicked();

    property <length> h: body-height;
    property <color> marks: dark-chassis ? #76767a : #a9a9a6;

    width: 0.5971 * h;
    height: h;
    border-radius: 0.0386 * h;

    // Glossy polycarbonate, not a flat fill. The real front is a moulded plastic face with a
    // highlight that falls off toward the bottom; two stops read as that at every size, and a third
    // starts to look like a button.
    background: @linear-gradient(180deg,
        chassis.brighter(dark-chassis ? 0.22 : 0.06) 0%,
        chassis 42%,
        chassis.darker(dark-chassis ? 0.10 : 0.05) 100%);

    // A hairline, not a drop shadow: nothing in this program floats (§2.4), and a shadow is the
    // visual grammar of floating.
    border-width: 1px;
    border-color: dark-chassis ? #00000060 : #0000001f;

    // ── The screen ──
    //
    // The active area sits inside a black glass panel that overhangs it slightly, which is what
    // gives a real iPod its bezel. Drawing the framebuffer flush to the body — the first draft —
    // is why it read as a sticker rather than a display.
    glass := Rectangle {
        x: (parent.width - self.width) / 2;
        y: 0.0870 * h - 0.020 * h;
        width: 0.4909 * h + 0.040 * h;
        height: 0.3681 * h + 0.040 * h;
        background: #08080a;
        border-radius: 0.010 * h;
        border-width: 1px;
        border-color: #ffffff14;

        Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 0.4909 * h;
            height: 0.3681 * h;
            source: screen-source;
            // The whole point (§2.8): nearest-neighbour, never smoothed, and the 4:3 well means it
            // is never stretched either.
            image-rendering: pixelated;
            image-fit: fill;
            visible: screen-lit;
        }
    }

    // ── The click wheel ──
    wheel := Rectangle {
        x: (parent.width - self.width) / 2;
        y: 0.5324 * h;
        width: 0.4155 * h;
        height: 0.4155 * h;
        border-radius: self.width / 2;
        background: @linear-gradient(180deg,
            chassis.brighter(dark-chassis ? 0.10 : 0.02) 0%,
            chassis.darker(dark-chassis ? 0.04 : 0.03) 100%);
        border-width: 1px;
        border-color: dark-chassis ? #ffffff14 : #00000014;

        // MENU is a word on the real device, so it is a word here. The other three are marks.
        Text {
            y: 0.030 * h;
            width: 100%;
            text: "MENU";
            horizontal-alignment: center;
            font-size: 0.030 * h;
            font-weight: 600;
            letter-spacing: 0.004 * h;
            color: marks;
        }
        WheelMark {
            kind: "prev";
            ink: marks;
            x: 0.030 * h;
            y: (parent.height - self.height) / 2;
            width: 0.042 * h;
            height: 0.028 * h;
        }
        WheelMark {
            kind: "next";
            ink: marks;
            x: parent.width - self.width - 0.030 * h;
            y: (parent.height - self.height) / 2;
            width: 0.042 * h;
            height: 0.028 * h;
        }
        WheelMark {
            kind: "play";
            ink: marks;
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 0.030 * h;
            width: 0.046 * h;
            height: 0.028 * h;
        }

        // The centre button.
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 0.1643 * h;
            height: 0.1643 * h;
            border-radius: self.width / 2;
            background: @linear-gradient(180deg,
                chassis.brighter(dark-chassis ? 0.14 : 0.03) 0%,
                chassis 100%);
            border-width: 1px;
            border-color: dark-chassis ? #ffffff1a : #00000014;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
