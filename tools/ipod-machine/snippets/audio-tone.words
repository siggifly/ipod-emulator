1a000003   @ 034 bne 48 <cpu>
e59f0140   @ 038 ldr r0, [pc, #320]
e3a01102   @ 03c mov r1, #-2147483648
e5801000   @ 040 str r1, [r0]
@ park:
eafffffe   @ 044 b 44 <park>
@ cpu:
