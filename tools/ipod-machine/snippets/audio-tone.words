e5803004   @ 058 str r3, [r0, #4]
@ next:
e4923004   @ 05c ldr r3, [r2], #4
e3730001   @ 060 cmn r3, #1
0a00000a   @ 064 beq 94 <codec_done>
e20340ff   @ 068 and r4, r3, #255
e580400c   @ 06c str r4, [r0, #12]
e1a04423   @ 070 lsr r4, r3, #8
e20440ff   @ 074 and r4, r4, #255
e5804010   @ 078 str r4, [r0, #16]
